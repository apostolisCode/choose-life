msgid "Translation engine: <strong>%s</strong>"
msgstr ""

#. translators: Badge next to the engine name under the word-count table; it marks one of the older engines WPML still supports but no longer recommends.
msgid "Legacy engine"
msgstr ""

#. translators: Warning under the word-count table. %s: the name of the translation engine the site uses, e.g. "DeepL". "Legacy" means one of the older engines.
#, js-format
msgid "Legacy pricing applied. %s is a legacy translation engine, not recommended for new sites and will be deprecated. Existing sites keep an adjusted word rate for it."
msgstr ""

