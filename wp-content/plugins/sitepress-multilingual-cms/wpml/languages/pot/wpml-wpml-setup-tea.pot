#, js-format
msgid "All %s"
msgstr ""

#. translators: Shown in the Include column of the word-count table for taxonomy terms: they follow whatever the translated content types do.
msgid "For translated types"
msgstr ""

#. translators: Option in the Include dropdown of the word-count table: nothing of this kind is translated.
msgid "None"
msgstr ""

#. translators: Shown in the Include column of the word-count table when only newer content counts. %s: a date, e.g. "2026-01-31".
#, js-format
msgid "Since %s"
msgstr ""

