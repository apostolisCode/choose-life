#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:112
msgid "You can't do that!"
msgstr "لا يمكنك القيام بذلك!"

#. translators: Question asked before the work sent to a translation service is dropped. %1$s: the name of that service.
#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:81
#, php-format
msgid "Are you sure you want to reset the %1$s translation process?"
msgstr "هل أنت متأكد أنك تريد إعادة تعيين عملية ترجمة %1$s؟"

#. translators: Message shown after the work sent to a translation service was dropped. %1$s: the name of that service.
#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:184
#, php-format
msgid "The translation process with %1$s was reset."
msgstr "تمت إعادة تعيين عملية الترجمة مع %1$s."

#. translators: Message shown after the site was disconnected from a translation service. %1$s: the name of that service, in both places. "the translators tab" is a tab of the Translation Management screen.
#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:187
#, php-format
msgid "Your site was successfully disconnected from %1$s. Go to the translators tab to connect a new %1$s account or use a different translation service."
msgstr "تم فصل موقعك بنجاح عن %1$s. انتقل إلى علامة تبويب المترجمين لربط حساب %1$s جديد أو استخدم خدمة ترجمة مختلفة."

#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:189
msgid "PRO translation has been reset."
msgstr "تمت إعادة تعيين الترجمة الاحترافية."

#: src/Integration/TranslationManagement/ResetPreferredTranslationService.php:18
msgid "Reset preferred translation service"
msgstr "إعادة تعيين خدمة الترجمة المفضلة"

#: src/Integration/TranslationManagement/ResetPreferredTranslationService.php:19
msgid "Reset and fetch  local preferred translation service to use Preferred Translation Service configured on WPML.org account."
msgstr "إعادة تعيين وجلب خدمة الترجمة المفضلة المحلية لاستخدام خدمة الترجمة المفضلة المكونة على حساب WPML.org."

#: src/Integration/TranslationManagement/ResetPreferredTranslationService.php:20
msgid "Reset & Fetch"
msgstr "إعادة تعيين وجلب"

#: src/Integration/TranslationManagement/SynchronizeSourceIdOfATEJobs/TriggerSynchronization.php:36
msgid "Synchronize local job ids with ATE jobs"
msgstr "مزامنة معرفات الوظائف المحلية مع وظائف ATE"

#: src/Integration/TranslationManagement/SynchronizeSourceIdOfATEJobs/TriggerSynchronization.php:44
msgid "Synchronize local job ids with their ATE counterparts. You will have to refresh a few times any admin page to accomplish the process."
msgstr "مزامنة معرفات الوظائف المحلية مع نظيراتها في ATE. سيتعين عليك تحديث أي صفحة مسؤول بضع مرات لإتمام العملية."

#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:38
msgid "No translation job IDs were provided."
msgstr "لم يتم توفير أي معرفات لوظائف الترجمة."

#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:62
msgid "No matching remote translation jobs were found for the provided job IDs."
msgstr "لم يتم العثور على وظائف ترجمة عن بُعد مطابقة لمعرفات الوظائف المقدمة."

#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:84
msgid "Invalid request: missing job IDs or the security check failed."
msgstr "طلب غير صالح: معرفات الوظائف مفقودة أو فشل التحقق الأمني."

#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:98
msgid "Fix WPML Translation Jobs \"tp_id\" field"
msgstr "إصلاح حقل ”tp_id“ لوظائف ترجمة WPML"

#. translators: Explanation under a tool on the Troubleshooting screen. "It" is that tool. "tp_id" and "rid" are field names and stay as they are; "in progress" is the wording of a translation state.
#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:100
msgid "Fixes the \"tp_id\" field of WPML ranslation jobs and set the status to \"in progress\" (it requires manual action to re-sync translation status + download translations). It accepts comma separated values of translation job IDs (rid)."
msgstr "يصلح حقل ”tp_id“ لوظائف ترجمة WPML ويضبط الحالة إلى ”قيد التنفيذ“ (يتطلب إجراءً يدويًا لإعادة مزامنة حالة الترجمة + تنزيل الترجمات). يقبل قيمًا مفصولة بفاصلة لمعرفات وظائف الترجمة (rid)."

#: src/Tool/ATESyncController.php:41
msgid "Synchronize with the <b>Advanced Translation Editor</b>"
msgstr "المزامنة مع <b>محرر الترجمة المتقدم</b>"

#: src/Tool/ATESyncController.php:44
msgid "Re-align local records with the state on the <b>Advanced Translation Editor</b> server."
msgstr "إعادة محاذاة السجلات المحلية مع الحالة على خادم <b>محرر الترجمة المتقدم</b>."

#. translators: Warning above a group of tools on WPML → Support. "These" are the tools below it.
#: src/Tool/ATESyncController.php:53
msgid "Only run these when WPML Support asks you to"
msgstr "لا تقم بتشغيل هذه الأدوات إلا عندما يطلب منك دعم WPML ذلك"

#: src/Tool/ATESyncController.php:56
msgid "These tools push local data to overwrite the ATE server's view. Running them at the wrong time can unassign translators, reset job ownership, or duplicate jobs."
msgstr "تقوم هذه الأدوات بدفع البيانات المحلية لإلغاء عرض خادم ATE. تشغيلها في الوقت الخطأ يمكن أن يؤدي إلى إلغاء تعيين المترجمين، أو إعادة تعيين ملكية الوظائف، أو تكرار الوظائف."

#: src/Tool/ATESyncController.php:64
msgid "Synchronize local job IDs with ATE"
msgstr "مزامنة معرفات الوظائف المحلية مع ATE"

#: src/Tool/ATESyncController.php:67
msgid "Reconciles the job IDs in your local database with the IDs on the ATE server when the two have drifted apart. Use to unblock jobs that appear stuck or can't be opened in the editor."
msgstr "توفيق معرفات الوظائف في قاعدة بياناتك المحلية مع المعرفات الموجودة على خادم ATE عندما يتباعد الاثنان. استخدمها لإلغاء حظر الوظائف التي تظهر عالقة أو لا يمكن فتحها في المحرر."

#: src/Tool/ATESyncController.php:73
#: src/Tool/ATESyncController.php:98
#: src/Tool/DatabaseStringsController.php:310
#: src/Tool/DatabaseStringsController.php:607
#: src/Tool/FixTranslationsController.php:213
msgid "I understand and want to proceed"
msgstr "أفهم ذلك وأريد المتابعة"

#: src/Tool/ATESyncController.php:81
msgid "Synchronize job IDs"
msgstr "مزامنة معرفات الوظائف"

#: src/Tool/ATESyncController.php:89
msgid "Synchronize translators and translation managers with ATE"
msgstr "مزامنة المترجمين ومديري الترجمة مع ATE"

#: src/Tool/ATESyncController.php:92
msgid "Re-pushes your current translator and translation-manager assignments to the ATE server. Use when translators are missing from the ATE-side assignment list, or are assigned to jobs they should not see."
msgstr "إعادة دفع تعيينات المترجمين ومديري الترجمة الحاليين إلى خادم ATE. استخدمها عندما يغيب المترجمون عن قائمة التعيينات في جانب ATE، أو عندما يتم تعيينهم لوظائف لا ينبغي لهم رؤيتها."

#: src/Tool/ATESyncController.php:106
msgid "Synchronize translators and managers"
msgstr "مزامنة المترجمين والمديرين"

