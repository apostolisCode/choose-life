#: src/Tool/DatabaseStringsController.php:75
#: src/Tools/DbStringsTools.php:81
msgid "Database & strings maintenance"
msgstr "Manutenção da base de dados e strings"

#: src/Tool/DatabaseStringsController.php:78
msgid "Direct operations on WPML's database tables and string-translation storage."
msgstr "Operações diretas nas tabelas da base de dados do WPML e no armazenamento de tradução de strings."

#: src/Tool/DatabaseStringsController.php:87
msgid "These tools can permanently delete or corrupt translation data"
msgstr "Estas ferramentas podem eliminar permanentemente ou corromper dados de tradução"

#. translators: %s renders the literal "Make a full database backup first" in bold.
#: src/Tool/DatabaseStringsController.php:93
#, php-format
msgid "Only run when WPML Support has reviewed your situation and asked you to. %s WPML will not be able to recover translations lost here."
msgstr "Execute apenas quando o Suporte do WPML tiver analisado a sua situação e o tiver solicitado. %s O WPML não poderá recuperar traduções perdidas aqui."

#: src/Tool/DatabaseStringsController.php:94
msgid "Make a full database backup first."
msgstr "Faça primeiro uma cópia de segurança completa da base de dados."

#: src/Tool/DatabaseStringsController.php:112
#: src/Tools/DbStringsTools.php:89
msgid "Database Tables Optimization"
msgstr "Otimização das tabelas da base de dados"

#. translators: Description of a Support tool on WPML → Support. %1$s, %2$s and %3$s: the names of three database tables, each shown in a code box. %4$s: a link, already wrapped in its tags, to the documentation for this tool.
#: src/Tool/DatabaseStringsController.php:115
#, php-format
msgid "Compresses WPML's translation tables (%1$s, %2$s, %3$s). Applies only to sites created before WPML 4.8, and only while the tables still hold redundant data. %4$s"
msgstr "Comprime as tabelas de tradução do WPML (%1$s, %2$s, %3$s). Aplica-se apenas a sites criados antes do WPML 4.8, e apenas enquanto as tabelas ainda contiverem dados redundantes. %4$s"

#. translators: Link on the Database Tables Optimization tool, opening the page that explains what the tool does.
#: src/Tool/DatabaseStringsController.php:121
msgid "Learn how this works"
msgstr "Saiba como isto funciona"

#: src/Tool/DatabaseStringsController.php:123
msgid "Optimize translation tables"
msgstr "Otimizar tabelas de tradução"

#. translators: %s renders the literal ".mo" file extension.
#: src/Tool/DatabaseStringsController.php:133
#, php-format
msgid "Drops the <b>String Translation</b> cache and re-indexes the strings tables. Applies only to sites originally translated before WPML 4.3, and only when every custom %s file is already generated."
msgstr "Elimina a cache de <b>String Translation</b> e reindexa as tabelas de strings. Aplica-se apenas a sites originalmente traduzidos antes do WPML 4.3, e apenas quando todos os ficheiros %s personalizados já estiverem gerados."

#: src/Tool/DatabaseStringsController.php:138
msgid "Clean up and optimize strings"
msgstr "Limpar e otimizar strings"

#: src/Tool/DatabaseStringsController.php:148
#: src/Tools/DbStringsTools.php:91
msgid "Remove ghost entries from translation tables"
msgstr "Remover entradas fantasma das tabelas de tradução"

#. translators: %s renders the literal `wp_icl_translations`.
#: src/Tool/DatabaseStringsController.php:151
#, php-format
msgid "Deletes rows in %s that point to posts or terms that no longer exist. Only use when support has confirmed that orphaned rows are your actual problem."
msgstr "Elimina linhas em %s que apontam para publicações ou termos que já não existem. Utilize apenas quando o suporte tiver confirmado que as linhas órfãs são o seu problema real."

#: src/Tool/DatabaseStringsController.php:154
msgid "Remove ghost entries"
msgstr "Remover entradas fantasma"

#: src/Tool/DatabaseStringsController.php:166
#: src/Tools/DbStringsTools.php:92
msgid "Show custom MO files pre-generation dialog"
msgstr "Mostrar diálogo de pré-geração de ficheiros MO personalizados"

#. translators: Message on WPML → Support. %1$s: the menu path "WPML → Translations → Strings", in bold, %2$s: the file extension ".mo" in a code box; it appears twice.
#: src/Tool/DatabaseStringsController.php:172
#, php-format
msgid "This action prepares the custom %2$s files dialog to appear the next time you open %1$s. Use that dialog to choose which custom %2$s files to regenerate."
msgstr "Esta ação prepara o diálogo de ficheiros %2$s personalizados para aparecer na próxima vez que abrir %1$s. Utilize esse diálogo para escolher quais os ficheiros %2$s personalizados a regenerar."

#: src/Tool/DatabaseStringsController.php:173
msgid "WPML → Translations → Strings"
msgstr "WPML → Traduções → Strings"

#: src/Tool/DatabaseStringsController.php:183
msgid "Show the dialog on the Strings tab"
msgstr "Mostrar o diálogo no separador Strings"

#: src/Tool/DatabaseStringsController.php:191
#: src/Tools/DbStringsTools.php:96
msgid "Remove language suffixes from taxonomy names"
msgstr "Remover sufixos de idioma dos nomes das taxonomias"

#: src/Tool/DatabaseStringsController.php:194
msgid "Strips language-code suffixes from taxonomy term names. Appears after certain legacy migrations where WPML created taxonomy duplicates with language-coded names."
msgstr "Remove os sufixos de código de idioma dos nomes dos termos de taxonomia. Aparece após certas migrações legadas onde o WPML criou duplicados de taxonomia com nomes codificados por idioma."

#: src/Tool/DatabaseStringsController.php:199
msgid "No taxonomy terms with language suffixes were detected."
msgstr "Não foram detetados termos de taxonomia com sufixos de idioma."

#. translators: Column heading in the renamed-terms table on WPML → Support: the name a category or tag had before. Noun phrase, not a verb.
#: src/Tool/DatabaseStringsController.php:207
msgid "Old name"
msgstr "Nome antigo"

#. translators: Column heading in the renamed-terms table on WPML → Support: the name that category or tag has now. Noun phrase, not a verb.
#: src/Tool/DatabaseStringsController.php:208
msgid "Updated name"
msgstr "Nome atualizado"

#. translators: Column heading in the renamed-terms table on WPML → Support: which categories or tags the change touches.
#: src/Tool/DatabaseStringsController.php:209
msgid "Affected taxonomies"
msgstr "Taxonomias afetadas"

#: src/Tool/DatabaseStringsController.php:234
msgid "Update term names"
msgstr "Atualizar nomes dos termos"

#: src/Tool/DatabaseStringsController.php:246
msgid "Scans WPML's string-translation tables for inconsistencies — duplicate string IDs, broken context links, mismatched languages — and reports what it finds. Read-only: nothing is changed until you act on the report."
msgstr "Analisa as tabelas de tradução de strings do WPML em busca de inconsistências — IDs de strings duplicados, links de contexto quebrados, idiomas desajustados — e comunica o que encontra. Apenas leitura: nada é alterado até que atue sobre o relatório."

#. translators: Link text on WPML → Support that starts a database check. Verb phrase, imperative.
#: src/Tool/DatabaseStringsController.php:249
msgid "Run check"
msgstr "Executar verificação"

#: src/Tool/DatabaseStringsController.php:256
#: src/Tool/DatabaseStringsController.php:263
#: src/Tools/DbStringsTools.php:94
msgid "Fix element_type collation"
msgstr "Corrigir o collation de element_type"

#. translators: Description of a Support tool on WPML → Support. %1$s: the name of a database column, in a code box, %2$s: the name of a database table, in a code box. "Illegal mix of collations" is a database error message and stays in English.
#: src/Tool/DatabaseStringsController.php:259
#, php-format
msgid "Aligns the collation of the %1$s column in %2$s with the rest of the database. Mismatched collation here causes \"Illegal mix of collations\" errors when WPML joins translation rows with WordPress posts or terms."
msgstr "Alinha o collation da coluna %1$s em %2$s com o resto da base de dados. O collation desajustado aqui causa erros “Illegal mix of collations” quando o WPML junta linhas de tradução com publicações ou termos do WordPress."

#: src/Tool/DatabaseStringsController.php:273
#: src/Tool/DatabaseStringsController.php:275
#: src/Tools/DbStringsTools.php:95
msgid "Fix WPML tables collation"
msgstr "Corrigir collation das tabelas do WPML"

#: src/Tool/DatabaseStringsController.php:274
msgid "Converts every WPML table to match the collation of WordPress's core tables. Use when string searches return wrong results, or when joins between WPML tables and WordPress tables raise collation errors. Broader than \"Fix element_type collation\" — touches all WPML tables, not just one column."
msgstr "Converte todas as tabelas do WPML para corresponderem ao collation das tabelas principais do WordPress. Utilize quando as pesquisas de strings devolverem resultados errados, ou quando as junções entre tabelas do WPML e tabelas do WordPress causarem erros de collation. Mais abrangente do que “Corrigir o collation de element_type” — toca em todas as tabelas do WPML, não apenas numa coluna."

#: src/Tool/DatabaseStringsController.php:287
#: src/Tool/DatabaseStringsController.php:315
#: src/Tools/DbStringsTools.php:97
msgid "Fix tp_id field"
msgstr "Corrigir campo tp_id"

#. translators: %s is the literal `tp_id`.
#: src/Tool/DatabaseStringsController.php:293
#, php-format
msgid "Repairs the %s column on the listed translation jobs and resets each job's status to in-progress. After running it, manually re-sync the translation status and download the translations for the affected jobs."
msgstr "Repara a coluna %s nos trabalhos de tradução listados e repõe o estado de cada trabalho para “em curso”. Após a execução, ressincronize manualmente o estado da tradução e descarregue as traduções para os trabalhos afetados."

#: src/Tool/DatabaseStringsController.php:300
msgid "Translation job IDs (rid)"
msgstr "IDs de trabalhos de tradução (rid)"

#: src/Tool/DatabaseStringsController.php:304
msgid "Comma-separated list of remote job IDs."
msgstr "Lista de IDs de trabalhos remotos separada por vírgulas."

#: src/Tool/DatabaseStringsController.php:419
msgid "Enter at least one job ID."
msgstr "Introduza pelo menos um ID de trabalho."

#: src/Tool/DatabaseStringsController.php:440
msgid "Done. Re-sync the affected jobs from Translation Management."
msgstr "Concluído. Ressincronize os trabalhos afetados em Gestão de Tradução."

#: src/Tool/DatabaseStringsController.php:465
msgid "Nothing to do — the tables were already optimized."
msgstr "Nada a fazer — as tabelas já estavam otimizadas."

#. translators: %d is replaced client-side with the number of rows the Optimize translation tables button drained.
#: src/Tool/DatabaseStringsController.php:466
#, php-format
msgid "Optimized %d row(s)."
msgstr "Otimizada(s) %d linha(s)."

#: src/Tool/DatabaseStringsController.php:535
msgid "Select at least one term."
msgstr "Selecione pelo menos um termo."

#. translators: Status shown next to a button on WPML → Support while the change is being written.
#: src/Tool/DatabaseStringsController.php:539
msgid "Updating…"
msgstr "A atualizar…"

#: src/Tool/DatabaseStringsController.php:564
msgid "All term names updated."
msgstr "Todos os nomes de termos atualizados."

#. translators: Status shown next to a button on WPML → Support once its action has finished. Adjective, not the verb "to do".
#: src/Tool/FixLanguageDataController.php:50
msgid "Done"
msgstr "Concluído"

#. translators: Status shown next to a button on WPML → Support while its action is running.
#: src/Tool/FixLanguageDataController.php:55
msgid "Running…"
msgstr "A executar…"

#: src/Tool/FixLanguageDataController.php:60
#: src/Tools/FixToolsTools.php:147
msgid "Fix language data"
msgstr "Corrigir dados de idioma"

#: src/Tool/FixLanguageDataController.php:63
msgid "Repair language-related fields on content. These tools are safe to run — they don't delete anything, they only fill in or align missing information."
msgstr "Reparar campos relacionados com o idioma no conteúdo. Estas ferramentas são seguras de executar — não eliminam nada, apenas preenchem ou alinham informações em falta."

#. translators: Name of a Support tool section: its entry in the Support search list, its heading and its button label. Verb phrase, imperative.
#: src/Tool/FixLanguageDataController.php:73
#: src/Tool/FixLanguageDataController.php:81
#: src/Tools/FixToolsTools.php:134
msgid "Set language information"
msgstr "Definir informações de idioma"

#: src/Tool/FixLanguageDataController.php:76
msgid "Assigns the site's default language to any content that was created without language metadata — typically content imported from another tool or added before WPML was active. Existing language assignments are preserved."
msgstr "Atribui o idioma predefinido do site a qualquer conteúdo que tenha sido criado sem metadados de idioma — normalmente conteúdo importado de outra ferramenta ou adicionado antes do WPML estar ativo. As atribuições de idioma existentes são preservadas."

#: src/Tool/FixLanguageDataController.php:88
msgid "Synchronize posts' taxonomies"
msgstr "Sincronizar taxonomias das publicações"

#: src/Tool/FixLanguageDataController.php:91
msgid "Re-applies the original post's category and tag assignments to its translations. Fixes translations that are missing categories or tags after a migration."
msgstr "Reaplica as atribuições de categoria e etiqueta da publicação original às suas traduções. Corrige traduções que não têm categorias ou etiquetas após uma migração."

#: src/Tool/FixLanguageDataController.php:110
msgid "No translatable post types"
msgstr "Sem tipos de publicação traduzíveis"

#. translators: Button label on WPML → Support. Verb phrase, imperative.
#: src/Tool/FixLanguageDataController.php:116
msgid "Synchronize taxonomies"
msgstr "Sincronizar taxonomias"

#: src/Tool/FixLanguageDataController.php:125
#: src/Tools/FixToolsTools.php:136
msgid "Fix terms count"
msgstr "Corrigir contagem de termos"

#: src/Tool/FixLanguageDataController.php:128
msgid "Recalculates the post counts shown next to categories, tags, and other taxonomy terms. Run this if the numbers in your taxonomy lists look wrong — for example, a category showing 0 posts when there are translated posts assigned to it."
msgstr "Recalcula as contagens de publicações mostradas junto a categorias, etiquetas e outros termos de taxonomia. Execute isto se os números nas suas listas de taxonomias parecerem errados — por exemplo, uma categoria a mostrar 0 publicações quando existem publicações traduzidas atribuídas a ela."

#. translators: Button label on WPML → Support that counts the items in each category and tag again. Verb phrase, imperative.
#: src/Tool/FixLanguageDataController.php:133
msgid "Recalculate counts"
msgstr "Recalcular contagens"

#: src/Tool/FixLanguageDataController.php:140
#: src/Tools/FixToolsTools.php:137
msgid "Fix post type assignment"
msgstr "Corrigir atribuição de tipo de publicação"

#: src/Tool/FixLanguageDataController.php:143
msgid "Repairs translations whose post type doesn't match the original — for instance, a translated product saved as a regular post. Usually happens after importing content or switching how custom post types are registered."
msgstr "Repara traduções cujo tipo de publicação não corresponde ao original — por exemplo, um produto traduzido guardado como uma publicação normal. Acontece geralmente após a importação de conteúdo ou a alteração da forma como os tipos de publicação personalizados são registados."

#: src/Tool/FixLanguageDataController.php:148
msgid "Fix post types"
msgstr "Corrigir tipos de publicação"

#: src/Tool/FixLanguageDataController.php:336
msgid "Languages without a country"
msgstr "Idiomas sem país"

#. translators: %d: number of languages with no country set.
#: src/Tool/FixLanguageDataController.php:343
#, php-format
msgid "%d language is set up for a specific country but has none chosen."
msgid_plural "%d languages are set up for a specific country but have none chosen."
msgstr[0] "%d idioma está configurado para um país específico mas não tem nenhum escolhido."
msgstr[1] "%d idiomas estão configurados para um país específico mas não têm nenhum escolhido."

#. translators: Note on WPML → Support. %1$s: opening link tag, %2$s: closing link tag; together they turn "Settings → Languages" into a link. hreflang is an HTML attribute name and stays as it is.
#: src/Tool/FixLanguageDataController.php:363
#, php-format
msgid "Nothing is broken and nothing needs doing: these languages work as they are. Choosing a country for one on the %1$sSettings → Languages%2$s page sets its hreflang tag to match, and offers to move its locale, flag and names with it."
msgstr "Nada está quebrado e nada precisa de ser feito: estes idiomas funcionam como estão. Escolher um país para um na página %1$sDefinições → Idiomas%2$s define a sua etiqueta hreflang para corresponder, e oferece-se para mover o seu locale, bandeira e nomes com ele."

#: src/Tool/FixLanguageDataController.php:417
msgid "Languages set up for a different country"
msgstr "Idiomas configurados para um país diferente"

#. translators: %d: number of languages whose WordPress locale does not match their country.
#: src/Tool/FixLanguageDataController.php:424
#, php-format
msgid "%d language's WordPress locale does not match the country it is set to."
msgid_plural "%d languages' WordPress locales do not match the countries they are set to."
msgstr[0] "O locale do WordPress do idioma %d não corresponde ao país para o qual está definido."
msgstr[1] "Os locales do WordPress dos idiomas %d não correspondem aos países para os quais estão definidos."

#. translators: Follows a language's name on WPML → Support when the name stored in the database differs from the one the Languages page shows. %s: the name stored in the database.
#: src/Tool/FixLanguageDataController.php:455
#, php-format
msgid "(saved as %s)"
msgstr "(guardado como %s)"

#. translators: End of the sentence "<language name> is set to <locale>, its country implies <locale>" on WPML → Support. "Its" is the language. %1$s: the WordPress locale saved for that language, %2$s: the locale its country would give.
#: src/Tool/FixLanguageDataController.php:466
#, php-format
msgid "set to %1$s, its country implies %2$s"
msgstr "definido para %1$s, o seu país implica %2$s"

#. translators: Note on WPML → Support. %1$s: opening link tag, %2$s: closing link tag; together they turn "Settings → Languages" into a link.
#: src/Tool/FixLanguageDataController.php:479
#, php-format
msgid "Nothing is broken: WordPress keeps loading each language in the locale that is stored. You can change the locale on its own on the %1$sSettings → Languages%2$s page, without choosing the country again."
msgstr "Nada está quebrado: o WordPress continua a carregar cada idioma no locale que está armazenado. Pode alterar o locale por si só na página %1$sDefinições → Idiomas%2$s, sem escolher o país novamente."

#. translators: Name of a Support tool: its entry in the tool list on WPML → Support and the heading of its own screen. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:59
#: src/Tools/FixToolsTools.php:160
msgid "Fix translations"
msgstr "Corrigir traduções"

#: src/Tool/FixTranslationsController.php:62
msgid "Resolve common translation-state problems — stuck statuses, missing categories, stale caches."
msgstr "Resolver problemas comuns de estado de tradução — estados presos, categorias em falta, caches desatualizadas."

#: src/Tool/FixTranslationsController.php:68
#: src/Tools/FixToolsTools.php:168
msgid "Clear the cache in WPML"
msgstr "Limpar a cache no WPML"

#: src/Tool/FixTranslationsController.php:71
msgid "Flushes WPML's internal cache. Often the first thing to try after migrations, plugin updates, or when something looks out of sync."
msgstr "Limpa a cache interna do WPML. Frequentemente, a primeira coisa a tentar após migrações, atualizações de plugins ou quando algo parece dessincronizado."

#. translators: Status shown next to the Clear cache button on WPML → Support once the cache has been cleared.
#: src/Tool/FixTranslationsController.php:75
msgid "WPML's cache was cleared."
msgstr "A cache do WPML foi limpa."

#. translators: Status shown next to the Clear cache button on WPML → Support when the cache could not be cleared.
#: src/Tool/FixTranslationsController.php:76
msgid "Could not clear the cache — please retry."
msgstr "Não foi possível limpar a cache — tente novamente."

#. translators: Button label on WPML → Support. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:78
msgid "Clear cache"
msgstr "Limpar cache"

#: src/Tool/FixTranslationsController.php:86
#: src/Tools/FixToolsTools.php:169
msgid "Retry stuck automatic translations"
msgstr "Repetir traduções automáticas presas"

#: src/Tool/FixTranslationsController.php:89
msgid "Re-queues automatic translations that got stuck mid-process so they can finish. Use when an automatic translation has been pending for an unusually long time and hasn't completed."
msgstr "Reintroduz na fila as traduções automáticas que ficaram presas a meio do processo para que possam terminar. Utilize quando uma tradução automática estiver pendente por um tempo invulgarmente longo e não tiver sido concluída."

#: src/Tool/FixTranslationsController.php:95
msgid "Retry stuck translations"
msgstr "Repetir traduções presas"

#: src/Tool/FixTranslationsController.php:103
#: src/Tools/FixToolsTools.php:170
msgid "Refresh Translation Services"
msgstr "Atualizar serviços de tradução"

#. translators: %1$s and %2$s wrap a link to Settings → Translation Services.
#: src/Tool/FixTranslationsController.php:109
#, php-format
msgid "Re-fetches the list of available translation services from WPML. Run this if a service you signed up for isn't appearing in %1$sSettings → Translation Services%2$s, or after enabling a new service in your WPML account."
msgstr "Obtém novamente a lista de serviços de tradução disponíveis do WPML. Execute isto se um serviço que subscreveu não estiver a aparecer em %1$sDefinições → Serviços de Tradução%2$s, ou após ativar um novo serviço na sua conta WPML."

#. translators: Button label on WPML → Support that fetches the list of translation services again. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:118
msgid "Refresh services"
msgstr "Atualizar serviços"

#: src/Tool/FixTranslationsController.php:126
#: src/Tools/FixToolsTools.php:171
msgid "Update domain name in language switcher"
msgstr "Atualizar nome de domínio no seletor de idiomas"

#: src/Tool/FixTranslationsController.php:129
msgid "Rewrites the domain stored against each language in the language switcher to match the site's current home URL. Run this after a domain change or migration if the language switcher still points to the old domain."
msgstr "Reescreve o domínio armazenado para cada idioma no seletor de idiomas para corresponder ao URL inicial atual do site. Execute isto após uma alteração de domínio ou migração se o seletor de idiomas ainda apontar para o domínio antigo."

#. translators: Button label on WPML → Support that writes the site's current web address into the language switcher. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:135
msgid "Update domain"
msgstr "Atualizar domínio"

#. translators: Name of a Support tool section: its entry in the Support search list and its heading. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:143
#: src/Tools/FixToolsTools.php:173
msgid "Assign translation status to duplicates"
msgstr "Atribuir estado de tradução a duplicados"

#: src/Tool/FixTranslationsController.php:146
msgid "Marks WPML duplicates with a proper translation status so they appear to translation-management and automatic-translation tools. Run after bulk duplication."
msgstr "Marca os duplicados do WPML com um estado de tradução adequado para que apareçam nas ferramentas de gestão de tradução e tradução automática. Execute após a duplicação em massa."

#. translators: Button label on WPML → Support that gives duplicated content a translation status. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:151
msgid "Assign status"
msgstr "Atribuir estado"

#: src/Tool/FixTranslationsController.php:159
msgid "Enable other translation services"
msgstr "Ativar outros serviços de tradução"

#: src/Tool/FixTranslationsController.php:162
msgid "Temporarily ignores the preferred translation service configured in your WPML.org account so you can choose another provider. You can refresh the account preference below."
msgstr "Ignora temporariamente o serviço de tradução preferencial configurado na sua conta WPML.org para que possa escolher outro fornecedor. Pode atualizar a preferência da conta abaixo."

#: src/Tool/FixTranslationsController.php:167
msgid "Enable other services"
msgstr "Ativar outros serviços"

#: src/Tool/FixTranslationsController.php:175
#: src/Tools/FixToolsTools.php:174
msgid "Refresh preferred translation service"
msgstr "Atualizar serviço de tradução preferencial"

#: src/Tool/FixTranslationsController.php:178
msgid "Fetches the preferred translation service configured in your WPML.org account and applies it to this site again."
msgstr "Obtém o serviço de tradução preferencial configurado na sua conta WPML.org e aplica-o novamente a este site."

#: src/Tool/FixTranslationsController.php:183
msgid "Refresh preferred service"
msgstr "Atualizar serviço preferencial"

#. translators: Name of a Support tool section: its entry in the Support search list, its heading and its button label. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:191
#: src/Tool/FixTranslationsController.php:220
#: src/Tools/FixToolsTools.php:176
msgid "Reset professional translation state"
msgstr "Repor estado da tradução profissional"

#: src/Tool/FixTranslationsController.php:194
msgid "Clears ongoing professional-translation jobs on this site and re-enables sending content to translation. Use this if your translation service stopped working or you want to cancel every in-flight job at once."
msgstr "Limpa os trabalhos de tradução profissional em curso neste site e reativa o envio de conteúdo para tradução. Utilize isto se o seu serviço de tradução parou de funcionar ou se pretender cancelar todos os trabalhos em curso de uma só vez."

#: src/Tool/FixTranslationsController.php:204
msgid "This stops every translation job currently in progress"
msgstr "Isto interrompe todos os trabalhos de tradução atualmente em curso"

#: src/Tool/FixTranslationsController.php:207
msgid "Work already completed and delivered is kept. Jobs that are in-flight with a translator or service will be cancelled and won't be charged. You'll need to resend them if you still want those translations."
msgstr "O trabalho já concluído e entregue é mantido. Os trabalhos que estão em curso com um tradutor ou serviço serão cancelados e não serão cobrados. Terá de os reenviar se ainda pretender essas traduções."

#. translators: Status shown on WPML → Support while the tool reads the site's pages and posts.
#: src/Tool/InternalLinksController.php:66
msgid "Scanning posts…"
msgstr "A analisar publicações…"

#. translators: Status shown on WPML → Support while the tool reads the site's texts.
#: src/Tool/InternalLinksController.php:68
msgid "Scanning strings…"
msgstr "A analisar strings…"

#. translators: %s is the number of links that were rewired.
#: src/Tool/InternalLinksController.php:70
#, php-format
msgid "Done — %s legacy links rewired. Your internal links are now in sync."
msgstr "Concluído — %s links legados reencaminhados. Os seus links internos estão agora sincronizados."

#: src/Tool/InternalLinksController.php:71
msgid "Done. Your internal links are now in sync."
msgstr "Concluído. Os seus links internos estão agora sincronizados."

#: src/Tool/InternalLinksController.php:76
#: src/Tools/ResetTools.php:64
msgid "Update internal links"
msgstr "Atualizar links internos"

#: src/Tool/InternalLinksController.php:79
msgid "Some posts created before WPML 4.7 still need their internal links rewired to their translated versions. Run once to scan and fix those legacy posts. Newer posts have their links adjusted automatically — this action only applies to sites that carried content over from older WPML versions."
msgstr "Algumas publicações criadas antes do WPML 4.7 ainda precisam que os seus links internos sejam reencaminhados para as suas versões traduzidas. Execute uma vez para analisar e corrigir essas publicações legadas. As publicações mais recentes têm os seus links ajustados automaticamente — esta ação aplica-se apenas a sites que transportaram conteúdo de versões mais antigas do WPML."

#: src/Tool/InternalLinksController.php:88
msgid "Your internal links are already in sync."
msgstr "Os seus links internos já estão sincronizados."

#. translators: %s is the URL of the Sticky Links plugin documentation.
#: src/Tool/InternalLinksController.php:94
#, php-format
msgid "WPML keeps internal links updated automatically as you translate content. If you also want to switch language URL formats without breaking links, the %s add-on handles that case."
msgstr "O WPML mantém os links internos atualizados automaticamente à medida que traduz o conteúdo. Se também pretender alterar os formatos de URL de idioma sem quebrar os links, o add-on %s trata desse caso."

#. translators: Link text on WPML → Support naming the Sticky Links add-on. Product name: keep it as it is.
#: src/Tool/InternalLinksController.php:96
msgid "Sticky Links"
msgstr "Sticky links"

#: src/Tool/InternalLinksController.php:106
msgid "Adjust legacy internal links"
msgstr "Ajustar links internos legados"

#: src/Tool/InternalLinksController.php:109
msgid "Scans posts that still need link adjustments from before the automatic-tracking change in WPML 4.7. After this completes, the section disappears — it only runs once per site."
msgstr "Analisa publicações que ainda precisam de ajustes de links de antes da alteração de rastreio automático no WPML 4.7. Após a conclusão, a secção desaparece — apenas é executada uma vez por site."

#: src/Tool/InternalLinksController.php:115
msgid "Scan now and adjust links"
msgstr "Analisar agora e ajustar links"

#. translators: Name of a Support tool: its entry in the tool list on WPML → Support and the heading of its own screen. A package is a group of texts from one source, such as a form or a block.
#: src/Tool/PackagesController.php:36
#: src/Tools/DbStringsTools.php:104
msgid "Package management"
msgstr "Gestão de pacotes"

#: src/Tool/PackagesController.php:39
msgid "A \"package\" is a bundle of strings that another plugin hands to WPML so they can be translated — a Gravity Form's field labels, a Gutenberg block's preset text, a Toolset custom-post-type's admin labels, a page builder's shortcode strings. Packages are created and kept in sync automatically by the plugins that own them; you normally don't need to open this page."
msgstr "Um “pacote” é um conjunto de strings que outro plugin entrega ao WPML para que possam ser traduzidas — as etiquetas de campo de um Gravity Form, o texto predefinido de um bloco Gutenberg, as etiquetas de administração de um tipo de publicação personalizado do Toolset, as strings de shortcode de um construtor de páginas. Os pacotes são criados e mantidos sincronizados automaticamente pelos plugins que os detêm; normalmente não precisa de abrir esta página."

#: src/Tool/PackagesController.php:42
msgid "Come here only when a supporter is investigating a specific string that is not showing up for translation, or asks you to remove an orphaned package left over after a plugin was uninstalled. Deleting or re-registering a package here is a recovery action, not configuration."
msgstr "Venha aqui apenas quando um técnico de suporte estiver a investigar uma string específica que não está a aparecer para tradução, ou lhe pedir para remover um pacote órfão deixado após a desinstalação de um plugin. Eliminar ou voltar a registar um pacote aqui é uma ação de recuperação, não de configuração."

#: src/Tool/PackagesController.php:51
msgid "Deleting or editing packages here can break translations on your site"
msgstr "Eliminar ou editar pacotes aqui pode quebrar as traduções no seu site"

#: src/Tool/PackagesController.php:54
msgid "These packages are created and maintained by the plugins they belong to. Manual changes here can orphan strings and remove translations from forms, blocks, and templates. Only make changes when WPML Support asks you to."
msgstr "Estes pacotes são criados e mantidos pelos plugins a que pertencem. Alterações manuais aqui podem deixar strings órfãs e remover traduções de formulários, blocos e modelos. Apenas faça alterações quando o Suporte do WPML o solicitar."

#. translators: Message on WPML → Support. A package is a group of texts from one source, such as a form or a block. Keep the <b> tags around the plugin name.
#: src/Tool/PackagesController.php:76
msgid "Package management requires the WPML String Translation plugin to be active."
msgstr "A gestão de pacotes requer que o plugin WPML String Translation esteja ativo."

#. translators: Name of a Support tool: its entry in the tool list on WPML → Support, the heading of its own screen, and its button label. Verb phrase, imperative (reset WPML on this site).
#: src/Tool/ResetController.php:44
#: src/Tool/ResetController.php:97
#: src/Tools/ResetTools.php:101
msgid "Reset WPML"
msgstr "Repor WPML"

#: src/Tool/ResetController.php:47
msgid "Last-resort recovery. This permanently deletes data and cannot be undone. Make a full database backup before running it."
msgstr "Recuperação de último recurso. Isto elimina permanentemente os dados e não pode ser anulado. Faça uma cópia de segurança completa da base de dados antes de o executar."

#: src/Tool/ResetController.php:54
#: src/Tools/ResetTools.php:109
msgid "Reset WPML entirely"
msgstr "Repor o WPML inteiramente"

#: src/Tool/ResetController.php:57
msgid "Deletes every WPML table, removes all language assignments on your content, and deactivates the plugin. Your multilingual site returns to a single-language WordPress install."
msgstr "Elimina todas as tabelas do WPML, remove todas as atribuições de idioma no seu conteúdo e desativa o plugin. O seu site multilingue regressa a uma instalação do WordPress de idioma único."

#: src/Tool/ResetController.php:67
msgid "This isn't a toy button"
msgstr "Isto não é um botão de brincar"

#. translators: Warning on WPML → Support above the reset button. "It" is the reset.
#: src/Tool/ResetController.php:70
msgid "It will completely reset WPML and permanently delete all language information from your site. Translated content stays in your WordPress database but loses its connection to other translations and to its language. You'll need to reinstall WPML and rebuild your language setup from scratch. There's no undo."
msgstr "Irá repor completamente o WPML e eliminar permanentemente todas as informações de idioma do seu site. O conteúdo traduzido permanece na sua base de dados do WordPress, mas perde a sua ligação a outras traduções e ao seu idioma. Terá de reinstalar o WPML e reconstruir a sua configuração de idioma do zero. Não há como anular."

#. translators: Label of the confirmation checkbox on WPML → Support. "This" is resetting WPML. Written in the first person, as the user saying it.
#: src/Tool/ResetController.php:80
msgid "I understand this will permanently delete all of WPML's language data"
msgstr "Compreendo que isto irá eliminar permanentemente todos os dados de idioma do WPML"

#. translators: %s is the literal phrase the user must type, wrapped in a span.
#: src/Tool/ResetController.php:87
#, php-format
msgid "Type %s to confirm"
msgstr "Escreva %s para confirmar"

#: src/Tool/ResetController.php:143
msgid "You do not have permission to reset WPML."
msgstr "Não tem permissão para repor o WPML."

#. translators: Shown while a dialog or a panel is still fetching what it has to show.
#: src/Tool/UrlResolutionCacheSection.php:58
msgid "Loading…"
msgstr "A carregar…"

#. translators: Status shown on WPML → Support while the address cache is being built again.
#: src/Tool/UrlResolutionCacheSection.php:62
msgid "Rebuilding…"
msgstr "A reconstruir…"

#: src/Tool/UrlResolutionCacheSection.php:63
msgid "Clear and rebuild cache"
msgstr "Limpar e reconstruir cache"

#: src/Tool/UrlResolutionCacheSection.php:64
msgid "Clear and rebuild the URL resolution cache for this site? Links may temporarily stay in their source language while the cache rebuilds."
msgstr "Limpar e reconstruir a cache de resolução de URL para este site? Os links podem permanecer temporariamente no seu idioma de origem enquanto a cache é reconstruída."

#: src/Tool/UrlResolutionCacheSection.php:65
msgid "The URL resolution cache request failed."
msgstr "O pedido de cache de resolução de URL falhou."

#: src/Tool/UrlResolutionCacheSection.php:66
msgid "The URL resolution cache rebuild is complete."
msgstr "A reconstrução da cache de resolução de URL está concluída."

#: src/Tool/UrlResolutionCacheSection.php:67
msgid "Preparing the cache rebuild…"
msgstr "A preparar a reconstrução da cache…"

#. translators: Row label on the address-cache block of WPML → Support: which round of the cache the numbers below belong to.
#: src/Tool/UrlResolutionCacheSection.php:69
msgid "Generation"
msgstr "Geração"

#. translators: Heading of a count on the address-cache block of WPML → Support: the addresses the cache has worked out. Adjective describing them, not a verb.
#: src/Tool/UrlResolutionCacheSection.php:71
msgid "Resolved"
msgstr "Resolvido"

#. translators: Heading of a count on the address-cache block of WPML → Support: the addresses the cache has not worked out yet. Adjective, not a verb.
#: src/Tool/UrlResolutionCacheSection.php:73
msgid "Unresolved"
msgstr "Não resolvido"

#. translators: Heading of a count on the address-cache block of WPML → Support: the addresses still waiting to be processed. Adjective, not a verb.
#: src/Tool/UrlResolutionCacheSection.php:75
msgid "Pending"
msgstr "Pendente"

#. translators: Heading of a count on the address-cache block of WPML → Support: the addresses the cache could not process. Adjective, not a verb.
#: src/Tool/UrlResolutionCacheSection.php:77
msgid "Failed"
msgstr "Falhou"

#: src/Tool/UrlResolutionCacheSection.php:78
msgid "Oldest pending item"
msgstr "Item pendente mais antigo"

#: src/Tool/UrlResolutionCacheSection.php:79
msgid "Last worker run"
msgstr "Última execução do worker"

#: src/Tool/UrlResolutionCacheSection.php:80
msgid "WP-Cron is disabled. Keep this page open to process cache batches, or configure a system cron runner."
msgstr "O WP-Cron está desativado. Mantenha esta página aberta para processar lotes de cache, ou configure um executor de cron do sistema."

#: src/Tool/UrlResolutionCacheSection.php:81
msgid "URL resolution cache processing appears to be stalled."
msgstr "O processamento da cache de resolução de URL parece estar parado."

#. translators: Message on WPML → Support. "It" is the database table.
#: src/Tool/UrlResolutionCacheSection.php:83
msgid "The URL resolution cache table is missing. It is created automatically on the next admin or front-end request."
msgstr "A tabela de cache de resolução de URL está em falta. É criada automaticamente no próximo pedido de administração ou front-end."

