msgstr "Очистити та оптимізувати таблиці рядків"

#: src/Integration/StringTranslation/BackendHooks.php:41
msgid "Cleanup and optimization completed!"
msgstr "Очищення та оптимізація завершені!"

#: src/Integration/StringTranslation/BackendHooks.php:46
#: src/Tool/DatabaseStringsController.php:243
#: src/Tools/DbStringsTools.php:93
msgid "Check for string issues"
msgstr "Перевірити наявність проблем із рядками"

#. translators: Name of the WPML Support screen: the admin menu item, the page heading, and the back-link that returns to it. Noun (help from the WPML support team), not the verb "to support".
#: src/Integration/StringTranslation/StringTroubleshootingMenuAlias.php:106
msgid "Support"
msgstr "Support"

#. translators: Answer returned when a job on the Troubleshooting screen went through.
#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-clear-ts.php:37
msgid "Ok!"
msgstr "Гаразд!"

#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-clear-ts.php:39
#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:102
#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:112
msgid "You can't do that!"
msgstr "Ви не можете цього зробити!"

#. translators: Question asked before the work sent to a translation service is dropped. %1$s: the name of that service.
#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:81
#, php-format
msgid "Are you sure you want to reset the %1$s translation process?"
msgstr "Ви впевнені, що хочете скинути процес перекладу %1$s?"

#. translators: Message shown after the work sent to a translation service was dropped. %1$s: the name of that service.
#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:184
#, php-format
msgid "The translation process with %1$s was reset."
msgstr "Процес перекладу з %1$s було скинуто."

#. translators: Message shown after the site was disconnected from a translation service. %1$s: the name of that service, in both places. "the translators tab" is a tab of the Translation Management screen.
#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:187
#, php-format
msgid "Your site was successfully disconnected from %1$s. Go to the translators tab to connect a new %1$s account or use a different translation service."
msgstr "Ваш сайт було успішно від’єднано від %1$s. Перейдіть на вкладку перекладачів, щоб під’єднати новий акаунт %1$s або скористайтеся іншим сервісом перекладу."

#: src/Integration/TranslationManagement/class-wpml-tm-troubleshooting-reset-pro-trans-config.php:189
msgid "PRO translation has been reset."
msgstr "Професійний переклад було скинуто."

#: src/Integration/TranslationManagement/ResetPreferredTranslationService.php:18
msgid "Reset preferred translation service"
msgstr "Скинути пріоритетний сервіс перекладу"

#: src/Integration/TranslationManagement/ResetPreferredTranslationService.php:19
msgid "Reset and fetch  local preferred translation service to use Preferred Translation Service configured on WPML.org account."
msgstr "Скинути та отримати локальний пріоритетний сервіс перекладу, щоб використовувати пріоритетний сервіс перекладу, налаштований в акаунті WPML.org."

#: src/Integration/TranslationManagement/ResetPreferredTranslationService.php:20
msgid "Reset & Fetch"
msgstr "Скинути та отримати"

#: src/Integration/TranslationManagement/SynchronizeSourceIdOfATEJobs/TriggerSynchronization.php:36
msgid "Synchronize local job ids with ATE jobs"
msgstr "Синхронізувати локальні ID завдань із завданнями ATE"

#: src/Integration/TranslationManagement/SynchronizeSourceIdOfATEJobs/TriggerSynchronization.php:44
msgid "Synchronize local job ids with their ATE counterparts. You will have to refresh a few times any admin page to accomplish the process."
msgstr "Синхронізуйте локальні ID завдань із їхніми аналогами в ATE. Вам доведеться кілька разів оновити будь-яку сторінку адмінпанелі, щоб завершити процес."

#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:38
msgid "No translation job IDs were provided."
msgstr "ID завдань перекладу не надано."

#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:62
msgid "No matching remote translation jobs were found for the provided job IDs."
msgstr "Для наданих ID завдань не знайдено відповідних віддалених завдань перекладу."

#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:84
msgid "Invalid request: missing job IDs or the security check failed."
msgstr "Некоректний запит: відсутні ID завдань або перевірка безпеки не вдалася."

#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:98
msgid "Fix WPML Translation Jobs \"tp_id\" field"
msgstr "Виправити поле «tp_id» завдань перекладу WPML"

#. translators: Explanation under a tool on the Troubleshooting screen. "It" is that tool. "tp_id" and "rid" are field names and stay as they are; "in progress" is the wording of a translation state.
#: src/Integration/TranslationManagement/WPML_TM_Troubleshooting_Fix_Translation_Jobs_TP_ID.php:100
msgid "Fixes the \"tp_id\" field of WPML ranslation jobs and set the status to \"in progress\" (it requires manual action to re-sync translation status + download translations). It accepts comma separated values of translation job IDs (rid)."
msgstr "Виправляє поле «tp_id» завдань перекладу WPML і встановлює статус «in progress» (потребує ручних дій для повторної синхронізації статусу перекладу + завантаження перекладів). Приймає значення ID завдань перекладу (rid), розділені комами."

#: src/Tool/ATESyncController.php:41
msgid "Synchronize with the <b>Advanced Translation Editor</b>"
msgstr "Синхронізувати з <b>Advanced Translation Editor</b>"

#: src/Tool/ATESyncController.php:44
msgid "Re-align local records with the state on the <b>Advanced Translation Editor</b> server."
msgstr "Повторно узгодити локальні записи зі станом на сервері <b>Advanced Translation Editor</b>."

#. translators: Warning above a group of tools on WPML → Support. "These" are the tools below it.
#: src/Tool/ATESyncController.php:53
msgid "Only run these when WPML Support asks you to"
msgstr "Запускайте це лише тоді, коли підтримка WPML попросить вас про це"

#: src/Tool/ATESyncController.php:56
msgid "These tools push local data to overwrite the ATE server's view. Running them at the wrong time can unassign translators, reset job ownership, or duplicate jobs."
msgstr "Ці інструменти надсилають локальні дані, щоб перезаписати стан на сервері ATE. Запуск їх у невідповідний час може призвести до скасування призначення перекладачів, скидання власників завдань або дублювання завдань."

#: src/Tool/ATESyncController.php:64
msgid "Synchronize local job IDs with ATE"
msgstr "Синхронізувати локальні ID завдань з ATE"

#: src/Tool/ATESyncController.php:67
msgid "Reconciles the job IDs in your local database with the IDs on the ATE server when the two have drifted apart. Use to unblock jobs that appear stuck or can't be opened in the editor."
msgstr "Узгоджує ID завдань у вашій локальній базі даних з ID на сервері ATE, якщо вони розійшлися. Використовуйте для розблокування завдань, які здаються застряглими або не відкриваються в редакторі."

#: src/Tool/ATESyncController.php:73
#: src/Tool/ATESyncController.php:98
#: src/Tool/DatabaseStringsController.php:310
#: src/Tool/DatabaseStringsController.php:607
#: src/Tool/FixTranslationsController.php:213
msgid "I understand and want to proceed"
msgstr "Я розумію і хочу продовжити"

#: src/Tool/ATESyncController.php:81
msgid "Synchronize job IDs"
msgstr "Синхронізувати ID завдань"

#: src/Tool/ATESyncController.php:89
msgid "Synchronize translators and translation managers with ATE"
msgstr "Синхронізувати перекладачів та менеджерів перекладу з ATE"

#: src/Tool/ATESyncController.php:92
msgid "Re-pushes your current translator and translation-manager assignments to the ATE server. Use when translators are missing from the ATE-side assignment list, or are assigned to jobs they should not see."
msgstr "Повторно надсилає ваші поточні призначення перекладачів та менеджерів перекладу на сервер ATE. Використовуйте, якщо перекладачі відсутні у списку призначень на стороні ATE або призначені на завдання, які вони не повинні бачити."

#: src/Tool/ATESyncController.php:106
msgid "Synchronize translators and managers"
msgstr "Синхронізувати перекладачів та менеджерів"

#. translators: Status shown next to a button on WPML → Support while its action is running.
#: src/Tool/ATESyncController.php:145
#: src/Tool/DatabaseStringsController.php:378
#: src/Tool/DatabaseStringsController.php:423
#: src/Tool/DatabaseStringsController.php:497
#: src/Tool/FixLanguageDataController.php:52
#: src/Tool/FixTranslationsController.php:54
#: src/Tool/UrlResolutionCacheSection.php:60
msgid "Working…"
msgstr "Виконується…"

#. translators: Status shown next to a button on WPML → Support once its action has finished.
#: src/Tool/ATESyncController.php:152
#: src/Tool/DatabaseStringsController.php:382
#: src/Tool/DatabaseStringsController.php:566
#: src/Tool/FixTranslationsController.php:52
msgid "Done."
msgstr "Готово."

#. translators: Status shown next to a button on WPML → Support once its action has finished.
#: src/Tool/ATESyncController.php:153
msgid "One of the syncs failed. Please retry."
msgstr "Одна із синхронізацій не вдалася. Будь ласка, спробуйте ще раз."

#: src/Tool/ATESyncController.php:158
#: src/Tool/DatabaseStringsController.php:386
#: src/Tool/DatabaseStringsController.php:442
#: src/Tool/DatabaseStringsController.php:516
#: src/Tool/DatabaseStringsController.php:570
#: src/Tool/FixLanguageDataController.php:53
#: src/Tool/FixTranslationsController.php:55
#: src/Tool/InternalLinksController.php:72
msgid "Something went wrong. Please retry."
msgstr "Щось пішло не так. Будь ласка, спробуйте ще раз."

#: src/Tool/DatabaseStringsController.php:75
#: src/Tools/DbStringsTools.php:81
msgid "Database & strings maintenance"
msgstr "Обслуговування бази даних та рядків"

#: src/Tool/DatabaseStringsController.php:78
msgid "Direct operations on WPML's database tables and string-translation storage."
msgstr "Прямі операції з таблицями бази даних WPML та сховищем перекладу рядків."

#: src/Tool/DatabaseStringsController.php:87
msgid "These tools can permanently delete or corrupt translation data"
msgstr "Ці інструменти можуть безповоротно видалити або пошкодити дані перекладу"

#. translators: %s renders the literal "Make a full database backup first" in bold.
#: src/Tool/DatabaseStringsController.php:93
#, php-format
msgid "Only run when WPML Support has reviewed your situation and asked you to. %s WPML will not be able to recover translations lost here."
msgstr "Запускайте лише тоді, коли підтримка WPML перевірила вашу ситуацію та попросила вас про це. %s WPML не зможе відновити переклади, втрачені тут."

#: src/Tool/DatabaseStringsController.php:94
msgid "Make a full database backup first."
msgstr "Спочатку зробіть повну резервну копію бази даних."

#: src/Tool/DatabaseStringsController.php:112
#: src/Tools/DbStringsTools.php:89
msgid "Database Tables Optimization"
msgstr "Оптимізація таблиць бази даних"

#. translators: Description of a Support tool on WPML → Support. %1$s, %2$s and %3$s: the names of three database tables, each shown in a code box. %4$s: a link, already wrapped in its tags, to the documentation for this tool.
#: src/Tool/DatabaseStringsController.php:115
#, php-format
msgid "Compresses WPML's translation tables (%1$s, %2$s, %3$s). Applies only to sites created before WPML 4.8, and only while the tables still hold redundant data. %4$s"
msgstr "Стискає таблиці перекладу WPML (%1$s, %2$s, %3$s). Застосовується лише до сайтів, створених до WPML 4.8, і лише поки таблиці все ще містять надлишкові дані. %4$s"

#. translators: Link on the Database Tables Optimization tool, opening the page that explains what the tool does.
#: src/Tool/DatabaseStringsController.php:121
msgid "Learn how this works"
msgstr "Дізнайтеся, як це працює"

#: src/Tool/DatabaseStringsController.php:123
msgid "Optimize translation tables"
msgstr "Оптимізувати таблиці перекладу"

#. translators: %s renders the literal ".mo" file extension.
#: src/Tool/DatabaseStringsController.php:133
#, php-format
msgid "Drops the <b>String Translation</b> cache and re-indexes the strings tables. Applies only to sites originally translated before WPML 4.3, and only when every custom %s file is already generated."
msgstr "Видаляє кеш <b>String Translation</b> та повторно індексує таблиці рядків. Застосовується лише до сайтів, спочатку перекладених до WPML 4.3, і лише коли кожен власний файл %s уже згенеровано."

#: src/Tool/DatabaseStringsController.php:138
msgid "Clean up and optimize strings"
msgstr "Очистити та оптимізувати рядки"

#: src/Tool/DatabaseStringsController.php:148
#: src/Tools/DbStringsTools.php:91
msgid "Remove ghost entries from translation tables"
msgstr "Видалити фантомні записи з таблиць перекладу"

#. translators: %s renders the literal `wp_icl_translations`.
#: src/Tool/DatabaseStringsController.php:151
#, php-format
msgid "Deletes rows in %s that point to posts or terms that no longer exist. Only use when support has confirmed that orphaned rows are your actual problem."
msgstr "Видаляє рядки в %s, які вказують на записи або терміни, що більше не існують. Використовуйте лише тоді, коли підтримка підтвердила, що осиротілі рядки є вашою реальною проблемою."

#: src/Tool/DatabaseStringsController.php:154
msgid "Remove ghost entries"
msgstr "Видалити фантомні записи"

#: src/Tool/DatabaseStringsController.php:166
#: src/Tools/DbStringsTools.php:92
msgid "Show custom MO files pre-generation dialog"
msgstr "Показати діалогове вікно попередньої генерації власних файлів MO"

#. translators: Message on WPML → Support. %1$s: the menu path "WPML → Translations → Strings", in bold, %2$s: the file extension ".mo" in a code box; it appears twice.
#: src/Tool/DatabaseStringsController.php:172
#, php-format
msgid "This action prepares the custom %2$s files dialog to appear the next time you open %1$s. Use that dialog to choose which custom %2$s files to regenerate."
msgstr "Ця дія готує діалогове вікно власних файлів %2$s до появи під час наступного відкриття %1$s. Використовуйте це діалогове вікно, щоб вибрати, які власні файли %2$s потрібно перегенерувати."

#: src/Tool/DatabaseStringsController.php:173
msgid "WPML → Translations → Strings"
msgstr "WPML → Переклади → Рядки"

#: src/Tool/DatabaseStringsController.php:183
msgid "Show the dialog on the Strings tab"
msgstr "Показати діалогове вікно на вкладці «Рядки»"

#: src/Tool/DatabaseStringsController.php:191
#: src/Tools/DbStringsTools.php:96
msgid "Remove language suffixes from taxonomy names"
msgstr "Видалити мовні суфікси з назв таксономій"

#: src/Tool/DatabaseStringsController.php:194
msgid "Strips language-code suffixes from taxonomy term names. Appears after certain legacy migrations where WPML created taxonomy duplicates with language-coded names."
msgstr "Видаляє суфікси мовних кодів із назв термінів таксономії. З’являється після певних застарілих міграцій, де WPML створював дублікати таксономій із назвами, що містять коди мов."

#: src/Tool/DatabaseStringsController.php:199
msgid "No taxonomy terms with language suffixes were detected."
msgstr "Термінів таксономії з мовними суфіксами не виявлено."

#. translators: Column heading in the renamed-terms table on WPML → Support: the name a category or tag had before. Noun phrase, not a verb.
#: src/Tool/DatabaseStringsController.php:207
msgid "Old name"
msgstr "Стара назва"

#. translators: Column heading in the renamed-terms table on WPML → Support: the name that category or tag has now. Noun phrase, not a verb.
#: src/Tool/DatabaseStringsController.php:208
msgid "Updated name"
msgstr "Оновлена назва"

#. translators: Column heading in the renamed-terms table on WPML → Support: which categories or tags the change touches.
#: src/Tool/DatabaseStringsController.php:209
msgid "Affected taxonomies"
msgstr "Зачеплені таксономії"

#: src/Tool/DatabaseStringsController.php:234
msgid "Update term names"
msgstr "Оновити назви термінів"

#: src/Tool/DatabaseStringsController.php:246
msgid "Scans WPML's string-translation tables for inconsistencies — duplicate string IDs, broken context links, mismatched languages — and reports what it finds. Read-only: nothing is changed until you act on the report."
msgstr "Сканує таблиці перекладу рядків WPML на наявність невідповідностей — дублікатів ID рядків, битих посилань на контекст, невідповідних мов — і повідомляє про знайдене. Тільки для читання: нічого не змінюється, доки ви не почнете діяти за звітом."

#. translators: Link text on WPML → Support that starts a database check. Verb phrase, imperative.
#: src/Tool/DatabaseStringsController.php:249
msgid "Run check"
msgstr "Запустити перевірку"

#: src/Tool/DatabaseStringsController.php:256
#: src/Tool/DatabaseStringsController.php:263
#: src/Tools/DbStringsTools.php:94
msgid "Fix element_type collation"
msgstr "Виправити collation element_type"

#. translators: Description of a Support tool on WPML → Support. %1$s: the name of a database column, in a code box, %2$s: the name of a database table, in a code box. "Illegal mix of collations" is a database error message and stays in English.
#: src/Tool/DatabaseStringsController.php:259
#, php-format
msgid "Aligns the collation of the %1$s column in %2$s with the rest of the database. Mismatched collation here causes \"Illegal mix of collations\" errors when WPML joins translation rows with WordPress posts or terms."
msgstr "Узгоджує collation стовпця %1$s у %2$s з рештою бази даних. Невідповідність collation тут спричиняє помилки «Illegal mix of collations», коли WPML об’єднує рядки перекладу з записами або термінами WordPress."

#: src/Tool/DatabaseStringsController.php:273
#: src/Tool/DatabaseStringsController.php:275
#: src/Tools/DbStringsTools.php:95
msgid "Fix WPML tables collation"
msgstr "Виправити collation таблиць WPML"

#: src/Tool/DatabaseStringsController.php:274
msgid "Converts every WPML table to match the collation of WordPress's core tables. Use when string searches return wrong results, or when joins between WPML tables and WordPress tables raise collation errors. Broader than \"Fix element_type collation\" — touches all WPML tables, not just one column."
msgstr "Конвертує кожну таблицю WPML відповідно до collation основних таблиць WordPress. Використовуйте, коли пошук рядків повертає неправильні результати або коли об’єднання таблиць WPML та WordPress викликає помилки collation. Ширше, ніж «Виправити collation element_type» — зачіпає всі таблиці WPML, а не лише один стовпець."

#: src/Tool/DatabaseStringsController.php:287
#: src/Tool/DatabaseStringsController.php:315
#: src/Tools/DbStringsTools.php:97
msgid "Fix tp_id field"
msgstr "Виправити поле tp_id"

#. translators: %s is the literal `tp_id`.
#: src/Tool/DatabaseStringsController.php:293
#, php-format
msgid "Repairs the %s column on the listed translation jobs and resets each job's status to in-progress. After running it, manually re-sync the translation status and download the translations for the affected jobs."
msgstr "Відновлює стовпець %s у вказаних завданнях перекладу та скидає статус кожного завдання на «in-progress». Після запуску вручну повторно синхронізуйте статус перекладу та завантажте переклади для зачеплених завдань."

#: src/Tool/DatabaseStringsController.php:300
msgid "Translation job IDs (rid)"
msgstr "ID завдань перекладу (rid)"

#: src/Tool/DatabaseStringsController.php:304
msgid "Comma-separated list of remote job IDs."
msgstr "Список ID віддалених завдань, розділених комами."

#: src/Tool/DatabaseStringsController.php:419
msgid "Enter at least one job ID."
msgstr "Введіть принаймні один ID завдання."

#: src/Tool/DatabaseStringsController.php:440
msgid "Done. Re-sync the affected jobs from Translation Management."
msgstr "Готово. Повторно синхронізуйте зачеплені завдання в керуванні перекладами."

#: src/Tool/DatabaseStringsController.php:465
msgid "Nothing to do — the tables were already optimized."
msgstr "Нічого не потрібно робити — таблиці вже оптимізовані."

#. translators: %d is replaced client-side with the number of rows the Optimize translation tables button drained.
#: src/Tool/DatabaseStringsController.php:466
#, php-format
msgid "Optimized %d row(s)."
msgstr "Оптимізовано %d рядків."

#: src/Tool/DatabaseStringsController.php:535
msgid "Select at least one term."
msgstr "Виберіть принаймні один термін."

#. translators: Status shown next to a button on WPML → Support while the change is being written.
#: src/Tool/DatabaseStringsController.php:539
msgid "Updating…"
msgstr "Оновлення…"

#: src/Tool/DatabaseStringsController.php:564
msgid "All term names updated."
msgstr "Усі назви термінів оновлено."

#. translators: Status shown next to a button on WPML → Support once its action has finished. Adjective, not the verb "to do".
#: src/Tool/FixLanguageDataController.php:50
msgid "Done"
msgstr "Готово"

#. translators: Status shown next to a button on WPML → Support while its action is running.
#: src/Tool/FixLanguageDataController.php:55
msgid "Running…"
msgstr "Виконується…"

#: src/Tool/FixLanguageDataController.php:60
#: src/Tools/FixToolsTools.php:147
msgid "Fix language data"
msgstr "Виправити мовні дані"

#: src/Tool/FixLanguageDataController.php:63
msgid "Repair language-related fields on content. These tools are safe to run — they don't delete anything, they only fill in or align missing information."
msgstr "Відновити пов’язані з мовою поля в контенті. Ці інструменти безпечні для запуску — вони нічого не видаляють, лише заповнюють або узгоджують відсутню інформацію."

#. translators: Name of a Support tool section: its entry in the Support search list, its heading and its button label. Verb phrase, imperative.
#: src/Tool/FixLanguageDataController.php:73
#: src/Tool/FixLanguageDataController.php:81
#: src/Tools/FixToolsTools.php:134
msgid "Set language information"
msgstr "Встановити мовну інформацію"

#: src/Tool/FixLanguageDataController.php:76
msgid "Assigns the site's default language to any content that was created without language metadata — typically content imported from another tool or added before WPML was active. Existing language assignments are preserved."
msgstr "Призначає мову сайту за замовчуванням будь-якому контенту, створеному без мовних метаданих — зазвичай контенту, імпортованому з іншого інструменту або доданому до активації WPML. Наявні призначення мов зберігаються."

#: src/Tool/FixLanguageDataController.php:88
msgid "Synchronize posts' taxonomies"
msgstr "Синхронізувати таксономії записів"

#: src/Tool/FixLanguageDataController.php:91
msgid "Re-applies the original post's category and tag assignments to its translations. Fixes translations that are missing categories or tags after a migration."
msgstr "Повторно застосовує призначення категорій та тегів оригінального запису до його перекладів. Виправляє переклади, у яких відсутні категорії або теги після міграції."

#: src/Tool/FixLanguageDataController.php:110
msgid "No translatable post types"
msgstr "Немає типів записів для перекладу"

#. translators: Button label on WPML → Support. Verb phrase, imperative.
#: src/Tool/FixLanguageDataController.php:116
msgid "Synchronize taxonomies"
msgstr "Синхронізувати таксономії"

#: src/Tool/FixLanguageDataController.php:125
#: src/Tools/FixToolsTools.php:136
msgid "Fix terms count"
msgstr "Виправити кількість термінів"

#: src/Tool/FixLanguageDataController.php:128
msgid "Recalculates the post counts shown next to categories, tags, and other taxonomy terms. Run this if the numbers in your taxonomy lists look wrong — for example, a category showing 0 posts when there are translated posts assigned to it."
msgstr "Перераховує кількість записів, що відображається поруч із категоріями, тегами та іншими термінами таксономії. Запустіть це, якщо числа у ваших списках таксономій виглядають неправильно — наприклад, категорія показує 0 записів, хоча до неї призначені перекладені записи."

#. translators: Button label on WPML → Support that counts the items in each category and tag again. Verb phrase, imperative.
#: src/Tool/FixLanguageDataController.php:133
msgid "Recalculate counts"
msgstr "Перерахувати кількість"

#: src/Tool/FixLanguageDataController.php:140
#: src/Tools/FixToolsTools.php:137
msgid "Fix post type assignment"
msgstr "Виправити призначення типу запису"

#: src/Tool/FixLanguageDataController.php:143
msgid "Repairs translations whose post type doesn't match the original — for instance, a translated product saved as a regular post. Usually happens after importing content or switching how custom post types are registered."
msgstr "Відновлює переклади, тип запису яких не відповідає оригіналу — наприклад, перекладений товар, збережений як звичайний запис. Зазвичай це трапляється після імпорту контенту або зміни способу реєстрації користувацьких типів записів."

#: src/Tool/FixLanguageDataController.php:148
msgid "Fix post types"
msgstr "Виправити типи записів"

#: src/Tool/FixLanguageDataController.php:336
msgid "Languages without a country"
msgstr "Мови без країни"

#. translators: %d: number of languages with no country set.
#: src/Tool/FixLanguageDataController.php:343
#, php-format
msgid "%d language is set up for a specific country but has none chosen."
msgid_plural "%d languages are set up for a specific country but have none chosen."
msgstr[0] "%d мова налаштована для конкретної країни, але країну не вибрано."
msgstr[1] "%d мови налаштовані для конкретної країни, але країну не вибрано."
msgstr[2] "%d мов налаштовані для конкретної країни, але країну не вибрано."

#. translators: Note on WPML → Support. %1$s: opening link tag, %2$s: closing link tag; together they turn "Settings → Languages" into a link. hreflang is an HTML attribute name and stays as it is.
#: src/Tool/FixLanguageDataController.php:363
#, php-format
msgid "Nothing is broken and nothing needs doing: these languages work as they are. Choosing a country for one on the %1$sSettings → Languages%2$s page sets its hreflang tag to match, and offers to move its locale, flag and names with it."
msgstr "Нічого не зламано і нічого не потрібно робити: ці мови працюють як є. Вибір країни для однієї з них на сторінці %1$sНалаштування → Мови%2$s встановлює відповідний тег hreflang і пропонує перемістити разом із ним локаль, прапор та назви."

#: src/Tool/FixLanguageDataController.php:417
msgid "Languages set up for a different country"
msgstr "Мови, налаштовані для іншої країни"

#. translators: %d: number of languages whose WordPress locale does not match their country.
#: src/Tool/FixLanguageDataController.php:424
#, php-format
msgid "%d language's WordPress locale does not match the country it is set to."
msgid_plural "%d languages' WordPress locales do not match the countries they are set to."
msgstr[0] "Локаль WordPress для %d мови не відповідає країні, для якої вона встановлена."
msgstr[1] "Локалі WordPress для %d мов не відповідають країнам, для яких вони встановлені."
msgstr[2] "Локалі WordPress для %d мов не відповідають країнам, для яких вони встановлені."

#. translators: Follows a language's name on WPML → Support when the name stored in the database differs from the one the Languages page shows. %s: the name stored in the database.
#: src/Tool/FixLanguageDataController.php:455
#, php-format
msgid "(saved as %s)"
msgstr "(збережено як %s)"

#. translators: End of the sentence "<language name> is set to <locale>, its country implies <locale>" on WPML → Support. "Its" is the language. %1$s: the WordPress locale saved for that language, %2$s: the locale its country would give.
#: src/Tool/FixLanguageDataController.php:466
#, php-format
msgid "set to %1$s, its country implies %2$s"
msgstr "встановлено %1$s, її країна передбачає %2$s"

#. translators: Note on WPML → Support. %1$s: opening link tag, %2$s: closing link tag; together they turn "Settings → Languages" into a link.
#: src/Tool/FixLanguageDataController.php:479
#, php-format
msgid "Nothing is broken: WordPress keeps loading each language in the locale that is stored. You can change the locale on its own on the %1$sSettings → Languages%2$s page, without choosing the country again."
msgstr "Нічого не зламано: WordPress продовжує завантажувати кожну мову в збереженій локалі. Ви можете змінити локаль окремо на сторінці %1$sНалаштування → Мови%2$s, не вибираючи країну знову."

#. translators: Name of a Support tool: its entry in the tool list on WPML → Support and the heading of its own screen. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:59
#: src/Tools/FixToolsTools.php:160
msgid "Fix translations"
msgstr "Виправити переклади"

#: src/Tool/FixTranslationsController.php:62
msgid "Resolve common translation-state problems — stuck statuses, missing categories, stale caches."
msgstr "Вирішити поширені проблеми зі станом перекладу — застряглі статуси, відсутні категорії, застарілі кеші."

#: src/Tool/FixTranslationsController.php:68
#: src/Tools/FixToolsTools.php:168
msgid "Clear the cache in WPML"
msgstr "Очистити кеш у WPML"

#: src/Tool/FixTranslationsController.php:71
msgid "Flushes WPML's internal cache. Often the first thing to try after migrations, plugin updates, or when something looks out of sync."
msgstr "Очищає внутрішній кеш WPML. Часто це перше, що варто спробувати після міграцій, оновлень плагінів або коли щось виглядає розсинхронізованим."

#. translators: Status shown next to the Clear cache button on WPML → Support once the cache has been cleared.
#: src/Tool/FixTranslationsController.php:75
msgid "WPML's cache was cleared."
msgstr "Кеш WPML очищено."

#. translators: Status shown next to the Clear cache button on WPML → Support when the cache could not be cleared.
#: src/Tool/FixTranslationsController.php:76
msgid "Could not clear the cache — please retry."
msgstr "Не вдалося очистити кеш — будь ласка, спробуйте ще раз."

#. translators: Button label on WPML → Support. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:78
msgid "Clear cache"
msgstr "Очистити кеш"

#: src/Tool/FixTranslationsController.php:86
#: src/Tools/FixToolsTools.php:169
msgid "Retry stuck automatic translations"
msgstr "Повторити застряглі автоматичні переклади"

#: src/Tool/FixTranslationsController.php:89
msgid "Re-queues automatic translations that got stuck mid-process so they can finish. Use when an automatic translation has been pending for an unusually long time and hasn't completed."
msgstr "Повторно ставить у чергу автоматичні переклади, які застрягли в процесі, щоб вони могли завершитися. Використовуйте, коли автоматичний переклад перебуває в стані очікування незвично довго і не завершується."

#: src/Tool/FixTranslationsController.php:95
msgid "Retry stuck translations"
msgstr "Повторити застряглі переклади"

#: src/Tool/FixTranslationsController.php:103
#: src/Tools/FixToolsTools.php:170
msgid "Refresh Translation Services"
msgstr "Оновити сервіси перекладу"

#. translators: %1$s and %2$s wrap a link to Settings → Translation Services.
#: src/Tool/FixTranslationsController.php:109
#, php-format
msgid "Re-fetches the list of available translation services from WPML. Run this if a service you signed up for isn't appearing in %1$sSettings → Translation Services%2$s, or after enabling a new service in your WPML account."
msgstr "Повторно отримує список доступних сервісів перекладу з WPML. Запустіть це, якщо сервіс, на який ви підписалися, не з’являється в %1$sНалаштування → Сервіси перекладу%2$s, або після ввімкнення нового сервісу у вашому акаунті WPML."

#. translators: Button label on WPML → Support that fetches the list of translation services again. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:118
msgid "Refresh services"
msgstr "Оновити сервіси"

#: src/Tool/FixTranslationsController.php:126
#: src/Tools/FixToolsTools.php:171
msgid "Update domain name in language switcher"
msgstr "Оновити доменне ім’я в перемикачі мов"

#: src/Tool/FixTranslationsController.php:129
msgid "Rewrites the domain stored against each language in the language switcher to match the site's current home URL. Run this after a domain change or migration if the language switcher still points to the old domain."
msgstr "Перезаписує домен, збережений для кожної мови в перемикачі мов, відповідно до поточної домашньої URL-адреси сайту. Запустіть це після зміни домену або міграції, якщо перемикач мов усе ще вказує на старий домен."

#. translators: Button label on WPML → Support that writes the site's current web address into the language switcher. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:135
msgid "Update domain"
msgstr "Оновити домен"

#. translators: Name of a Support tool section: its entry in the Support search list and its heading. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:143
#: src/Tools/FixToolsTools.php:173
msgid "Assign translation status to duplicates"
msgstr "Призначити статус перекладу дублікатам"

#: src/Tool/FixTranslationsController.php:146
msgid "Marks WPML duplicates with a proper translation status so they appear to translation-management and automatic-translation tools. Run after bulk duplication."
msgstr "Позначає дублікати WPML належним статусом перекладу, щоб вони з’являлися в інструментах керування перекладами та автоматичного перекладу. Запустіть після масового дублювання."

#. translators: Button label on WPML → Support that gives duplicated content a translation status. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:151
msgid "Assign status"
msgstr "Призначити статус"

#: src/Tool/FixTranslationsController.php:159
msgid "Enable other translation services"
msgstr "Увімкнути інші сервіси перекладу"

#: src/Tool/FixTranslationsController.php:162
msgid "Temporarily ignores the preferred translation service configured in your WPML.org account so you can choose another provider. You can refresh the account preference below."
msgstr "Тимчасово ігнорує пріоритетний сервіс перекладу, налаштований у вашому акаунті WPML.org, щоб ви могли вибрати іншого постачальника. Ви можете оновити налаштування акаунта нижче."

#: src/Tool/FixTranslationsController.php:167
msgid "Enable other services"
msgstr "Увімкнути інші сервіси"

#: src/Tool/FixTranslationsController.php:175
#: src/Tools/FixToolsTools.php:174
msgid "Refresh preferred translation service"
msgstr "Оновити пріоритетний сервіс перекладу"

#: src/Tool/FixTranslationsController.php:178
msgid "Fetches the preferred translation service configured in your WPML.org account and applies it to this site again."
msgstr "Отримує пріоритетний сервіс перекладу, налаштований у вашому акаунті WPML.org, і знову застосовує його до цього сайту."

#: src/Tool/FixTranslationsController.php:183
msgid "Refresh preferred service"
msgstr "Оновити пріоритетний сервіс"

#. translators: Name of a Support tool section: its entry in the Support search list, its heading and its button label. Verb phrase, imperative.
#: src/Tool/FixTranslationsController.php:191
#: src/Tool/FixTranslationsController.php:220
#: src/Tools/FixToolsTools.php:176
msgid "Reset professional translation state"
msgstr "Скинути стан професійного перекладу"

#: src/Tool/FixTranslationsController.php:194
msgid "Clears ongoing professional-translation jobs on this site and re-enables sending content to translation. Use this if your translation service stopped working or you want to cancel every in-flight job at once."
msgstr "Очищає поточні завдання професійного перекладу на цьому сайті та знову вмикає надсилання контенту на переклад. Використовуйте це, якщо ваш сервіс перекладу перестав працювати або ви хочете скасувати всі активні завдання одночасно."

#: src/Tool/FixTranslationsController.php:204
msgid "This stops every translation job currently in progress"
msgstr "Це зупинить кожне завдання перекладу, яке зараз виконується"

#: src/Tool/FixTranslationsController.php:207
msgid "Work already completed and delivered is kept. Jobs that are in-flight with a translator or service will be cancelled and won't be charged. You'll need to resend them if you still want those translations."
msgstr "Робота, яка вже завершена та доставлена, зберігається. Завдання, які перебувають у процесі виконання перекладачем або сервісом, будуть скасовані, і плата за них не стягуватиметься. Вам потрібно буде надіслати їх повторно, якщо ці переклади все ще потрібні."

#. translators: Status shown on WPML → Support while the tool reads the site's pages and posts.
#: src/Tool/InternalLinksController.php:66
msgid "Scanning posts…"
msgstr "Сканування записів…"

#. translators: Status shown on WPML → Support while the tool reads the site's texts.
#: src/Tool/InternalLinksController.php:68
msgid "Scanning strings…"
msgstr "Сканування рядків…"

#. translators: %s is the number of links that were rewired.
#: src/Tool/InternalLinksController.php:70
#, php-format
msgid "Done — %s legacy links rewired. Your internal links are now in sync."
msgstr "Готово — %s застарілих посилань перенаправлено. Ваші внутрішні посилання тепер синхронізовані."

#: src/Tool/InternalLinksController.php:71
msgid "Done. Your internal links are now in sync."
msgstr "Готово. Ваші внутрішні посилання тепер синхронізовані."

#: src/Tool/InternalLinksController.php:76
#: src/Tools/ResetTools.php:64
msgid "Update internal links"
msgstr "Оновити внутрішні посилання"

#: src/Tool/InternalLinksController.php:79
msgid "Some posts created before WPML 4.7 still need their internal links rewired to their translated versions. Run once to scan and fix those legacy posts. Newer posts have their links adjusted automatically — this action only applies to sites that carried content over from older WPML versions."
msgstr "Деякі записи, створені до WPML 4.7, усе ще потребують перенаправлення внутрішніх посилань на їхні перекладені версії. Запустіть один раз, щоб просканувати та виправити ці застарілі записи. Посилання в новіших записах коригуються автоматично — ця дія стосується лише сайтів, які перенесли контент зі старіших версій WPML."

#: src/Tool/InternalLinksController.php:88
msgid "Your internal links are already in sync."
msgstr "Ваші внутрішні посилання вже синхронізовані."

#. translators: %s is the URL of the Sticky Links plugin documentation.
#: src/Tool/InternalLinksController.php:94
#, php-format
msgid "WPML keeps internal links updated automatically as you translate content. If you also want to switch language URL formats without breaking links, the %s add-on handles that case."
msgstr "WPML автоматично оновлює внутрішні посилання під час перекладу контенту. Якщо ви також хочете змінити формати URL-адрес мов без порушення посилань, це вирішує аддон %s."

#. translators: Link text on WPML → Support naming the Sticky Links add-on. Product name: keep it as it is.
#: src/Tool/InternalLinksController.php:96
msgid "Sticky Links"
msgstr "Sticky links"

#: src/Tool/InternalLinksController.php:106
msgid "Adjust legacy internal links"
msgstr "Скоригувати застарілі внутрішні посилання"

#: src/Tool/InternalLinksController.php:109
msgid "Scans posts that still need link adjustments from before the automatic-tracking change in WPML 4.7. After this completes, the section disappears — it only runs once per site."
msgstr "Сканує записи, які все ще потребують коригування посилань, створених до впровадження автоматичного відстеження у WPML 4.7. Після завершення цей розділ зникне — він запускається лише один раз для кожного сайту."

#: src/Tool/InternalLinksController.php:115
msgid "Scan now and adjust links"
msgstr "Просканувати зараз і скоригувати посилання"

#. translators: Name of a Support tool: its entry in the tool list on WPML → Support and the heading of its own screen. A package is a group of texts from one source, such as a form or a block.
#: src/Tool/PackagesController.php:36
#: src/Tools/DbStringsTools.php:104
msgid "Package management"
msgstr "Керування пакетами"

#: src/Tool/PackagesController.php:39
msgid "A \"package\" is a bundle of strings that another plugin hands to WPML so they can be translated — a Gravity Form's field labels, a Gutenberg block's preset text, a Toolset custom-post-type's admin labels, a page builder's shortcode strings. Packages are created and kept in sync automatically by the plugins that own them; you normally don't need to open this page."
msgstr "«Пакет» — це набір рядків, які інший плагін передає WPML для перекладу: мітки полів Gravity Form, попередньо встановлений текст блоку Gutenberg, адмін-мітки користувацького типу записів Toolset, рядки шорткодів конструктора сторінок. Пакети створюються та синхронізуються автоматично плагінами, яким вони належать; зазвичай вам не потрібно відкривати цю сторінку."

#: src/Tool/PackagesController.php:42
msgid "Come here only when a supporter is investigating a specific string that is not showing up for translation, or asks you to remove an orphaned package left over after a plugin was uninstalled. Deleting or re-registering a package here is a recovery action, not configuration."
msgstr "Заходьте сюди лише тоді, коли спеціаліст підтримки досліджує конкретний рядок, який не з’являється для перекладу, або просить вас видалити осиротілий пакет, що залишився після видалення плагіна. Видалення або перереєстрація пакета тут є дією з відновлення, а не налаштуванням."

#: src/Tool/PackagesController.php:51
msgid "Deleting or editing packages here can break translations on your site"
msgstr "Видалення або редагування пакетів тут може порушити переклади на вашому сайті"

#: src/Tool/PackagesController.php:54
msgid "These packages are created and maintained by the plugins they belong to. Manual changes here can orphan strings and remove translations from forms, blocks, and templates. Only make changes when WPML Support asks you to."
msgstr "Ці пакети створюються та підтримуються плагінами, яким вони належать. Ручні зміни тут можуть призвести до появи осиротілих рядків та видалення перекладів із форм, блоків та шаблонів. Робіть зміни лише тоді, коли підтримка WPML попросить вас про це."

#. translators: Message on WPML → Support. A package is a group of texts from one source, such as a form or a block. Keep the <b> tags around the plugin name.
#: src/Tool/PackagesController.php:76
msgid "Package management requires the WPML String Translation plugin to be active."
msgstr "Для керування пакетами необхідно, щоб плагін WPML String Translation був активним."

#. translators: Name of a Support tool: its entry in the tool list on WPML → Support, the heading of its own screen, and its button label. Verb phrase, imperative (reset WPML on this site).
#: src/Tool/ResetController.php:44
#: src/Tool/ResetController.php:97
#: src/Tools/ResetTools.php:101
msgid "Reset WPML"
msgstr "Скинути WPML"

#: src/Tool/ResetController.php:47
msgid "Last-resort recovery. This permanently deletes data and cannot be undone. Make a full database backup before running it."
msgstr "Відновлення в крайньому разі. Це назавжди видаляє дані, і цю дію неможливо скасувати. Зробіть повну резервну копію бази даних перед запуском."

#: src/Tool/ResetController.php:54
#: src/Tools/ResetTools.php:109
msgid "Reset WPML entirely"
msgstr "Повністю скинути WPML"

#: src/Tool/ResetController.php:57
msgid "Deletes every WPML table, removes all language assignments on your content, and deactivates the plugin. Your multilingual site returns to a single-language WordPress install."
msgstr "Видаляє кожну таблицю WPML, видаляє всі призначення мов у вашому контенті та деактивує плагін. Ваш багатомовний сайт повертається до одномовної інсталяції WordPress."

#: src/Tool/ResetController.php:67
msgid "This isn't a toy button"
msgstr "Це не іграшкова кнопка"

#. translators: Warning on WPML → Support above the reset button. "It" is the reset.
#: src/Tool/ResetController.php:70
msgid "It will completely reset WPML and permanently delete all language information from your site. Translated content stays in your WordPress database but loses its connection to other translations and to its language. You'll need to reinstall WPML and rebuild your language setup from scratch. There's no undo."
msgstr "Це повністю скине WPML і назавжди видалить усю мовну інформацію з вашого сайту. Перекладений контент залишиться у вашій базі даних WordPress, але втратить зв’язок з іншими перекладами та своєю мовою. Вам потрібно буде заново встановити WPML і відбудувати мовні налаштування з нуля. Скасування неможливе."

#. translators: Label of the confirmation checkbox on WPML → Support. "This" is resetting WPML. Written in the first person, as the user saying it.
#: src/Tool/ResetController.php:80
msgid "I understand this will permanently delete all of WPML's language data"
msgstr "Я розумію, що це назавжди видалить усі мовні дані WPML"

#. translators: %s is the literal phrase the user must type, wrapped in a span.
#: src/Tool/ResetController.php:87
#, php-format
msgid "Type %s to confirm"
msgstr "Введіть %s для підтвердження"

#: src/Tool/ResetController.php:143
msgid "You do not have permission to reset WPML."
msgstr "У вас немає прав на скидання WPML."

#. translators: Shown while a dialog or a panel is still fetching what it has to show.
#: src/Tool/UrlResolutionCacheSection.php:58
msgid "Loading…"
msgstr "Завантаження…"

#. translators: Status shown on WPML → Support while the address cache is being built again.
#: src/Tool/UrlResolutionCacheSection.php:62
msgid "Rebuilding…"
msgstr "Перебудова…"

#: src/Tool/UrlResolutionCacheSection.php:63
msgid "Clear and rebuild cache"
msgstr "Очистити та перебудувати кеш"

#: src/Tool/UrlResolutionCacheSection.php:64
msgid "Clear and rebuild the URL resolution cache for this site? Links may temporarily stay in their source language while the cache rebuilds."
msgstr "Очистити та перебудувати кеш розпізнавання URL для цього сайту? Посилання можуть тимчасово залишатися мовою оригіналу, поки кеш перебудовується."

#: src/Tool/UrlResolutionCacheSection.php:65
msgid "The URL resolution cache request failed."
msgstr "Запит на кеш розпізнавання URL не вдався."

#: src/Tool/UrlResolutionCacheSection.php:66
msgid "The URL resolution cache rebuild is complete."
msgstr "Перебудова кешу розпізнавання URL завершена."

#: src/Tool/UrlResolutionCacheSection.php:67
msgid "Preparing the cache rebuild…"
msgstr "Підготовка до перебудови кешу…"

#. translators: Row label on the address-cache block of WPML → Support: which round of the cache the numbers below belong to.
#: src/Tool/UrlResolutionCacheSection.php:69
msgid "Generation"
msgstr "Генерація"

#. translators: Heading of a count on the address-cache block of WPML → Support: the addresses the cache has worked out. Adjective describing them, not a verb.
#: src/Tool/UrlResolutionCacheSection.php:71
msgid "Resolved"
msgstr "Розпізнано"

#. translators: Heading of a count on the address-cache block of WPML → Support: the addresses the cache has not worked out yet. Adjective, not a verb.
#: src/Tool/UrlResolutionCacheSection.php:73
msgid "Unresolved"
msgstr "Не розпізнано"

#. translators: Heading of a count on the address-cache block of WPML → Support: the addresses still waiting to be processed. Adjective, not a verb.
#: src/Tool/UrlResolutionCacheSection.php:75
msgid "Pending"
msgstr "У черзі"

#. translators: Heading of a count on the address-cache block of WPML → Support: the addresses the cache could not process. Adjective, not a verb.
#: src/Tool/UrlResolutionCacheSection.php:77
msgid "Failed"
msgstr "Не вдалося"

#: src/Tool/UrlResolutionCacheSection.php:78
msgid "Oldest pending item"
msgstr "Найстаріший елемент у черзі"

#: src/Tool/UrlResolutionCacheSection.php:79
msgid "Last worker run"
msgstr "Останній запуск воркера"

#: src/Tool/UrlResolutionCacheSection.php:80
msgid "WP-Cron is disabled. Keep this page open to process cache batches, or configure a system cron runner."
msgstr "WP-Cron вимкнено. Тримайте цю сторінку відкритою для обробки пакетів кешу або налаштуйте системний запуск cron."

#: src/Tool/UrlResolutionCacheSection.php:81
msgid "URL resolution cache processing appears to be stalled."
msgstr "Обробка кешу розпізнавання URL, схоже, зупинилася."

#. translators: Message on WPML → Support. "It" is the database table.
#: src/Tool/UrlResolutionCacheSection.php:83
msgid "The URL resolution cache table is missing. It is created automatically on the next admin or front-end request."
msgstr "Таблиця кешу розпізнавання URL відсутня. Вона буде створена автоматично під час наступного запиту до адмінпанелі або фронтенду."

#: src/Tool/UrlResolutionCacheSection.php:84
msgid "Last worker error"
msgstr "Остання помилка воркера"

#. translators: An em dash shown in place of a value on WPML → Support when there is nothing to show. Leave it as it is.
#: src/Tool/UrlResolutionCacheSection.php:86
msgid "—"
msgstr "—"

#: src/Tool/UrlResolutionCacheSection.php:91
msgid "Clear URL translations cache"
msgstr "Очистити кеш перекладів URL"

#: src/Tool/UrlResolutionCacheSection.php:94
msgid "WPML caches how individual front-end URLs resolve to translated content. Rebuild it after routing or translation changes if links still use an older result."
msgstr "WPML кешує те, як окремі URL-адреси фронтенду розв'язуються у перекладений контент. Перебудуйте його після змін у маршрутизації або перекладах, якщо посилання все ще використовують застарілий результат."

#. translators: %s is the site name followed by its numeric ID.
#: src/Tool/UrlResolutionCacheSection.php:100
#, php-format
msgid "Showing %s. Each site in a multisite network keeps its own cache."
msgstr "Показано %s. Кожен сайт у мережі мультисайту має власний кеш."

#: src/Tool/WcmlFixTranslationsController.php:25
#: src/Tools/ResetTools.php:79
msgid "Fix WCML translations"
msgstr "Виправити переклади WCML"

#: src/Tool/WcmlFixTranslationsController.php:29
msgid "Bulk repair tools for WooCommerce Multilingual that fill in missing data on translations or register missing items for translation. Tick the boxes you want to run, then submit once."
msgstr "Інструменти масового виправлення для WooCommerce Multilingual, які заповнюють відсутні дані в перекладах або реєструють відсутні елементи для перекладу. Позначте пункти, які потрібно виконати, а потім надішліть один раз."

#: src/Tool/WcmlTranslationMaintenanceController.php:32
#: src/Tools/ResetTools.php:115
msgid "WCML translation maintenance"
msgstr "Технічне обслуговування перекладів WCML"

#: src/Tool/WcmlTranslationMaintenanceController.php:36
msgid "Advanced repair tools for the WCML translation relationships. Only run these when WPML Support has asked you to — they rewrite the variation-translation link tables and delete unused custom fields from product translations."
msgstr "Розширені інструменти для відновлення зв'язків перекладів WCML. Запускайте їх лише за запитом служби підтримки WPML — вони перезаписують таблиці зв'язків варіацій і перекладів та видаляють невикористовувані спеціальні поля з перекладів товарів."

#: src/Tool/WcmlTranslationMaintenanceController.php:48
msgid "These tools rewrite translation data and can hide existing variations"
msgstr "Ці інструменти перезаписують дані перекладів і можуть приховати наявні варіації"

#: src/Tool/WcmlTranslationMaintenanceController.php:52
msgid "Make a full database backup before running them. Only check the boxes WPML Support has named, then press \"Run the selected tools\"."
msgstr "Зробіть повну резервну копію бази даних перед їх запуском. Позначайте лише ті пункти, які вказала служба підтримки WPML, а потім натисніть «Запустити вибрані інструменти»."

#: src/Tools/DbStringsTools.php:82
msgid "Optimize tables, clean up strings, remove ghost entries, regenerate MO files"
msgstr "Оптимізувати таблиці, очистити рядки, видалити застарілі записи, регенерувати MO-файли"

#: src/Tools/DbStringsTools.php:105
msgid "String packages from Gravity Forms, Gutenberg blocks, Toolset, etc."
msgstr "Пакети рядків із Gravity Forms, блоків Gutenberg, Toolset тощо."

#: src/Tools/DbStringsTools.php:112
msgid "Browse string-translation packages"
msgstr "Переглянути пакети перекладу рядків"

#: src/Tools/DbStringsTools.php:113
msgid "Re-register packages"
msgstr "Перереєструвати пакети"

#: src/Tools/FixToolsTools.php:129
msgid "Assign language to content, repair language data, sync taxonomies and rebuild the URL cache"
msgstr "Призначити мову контенту, виправити мовні дані, синхронізувати таксономії та перебудувати кеш URL"

#: src/Tools/FixToolsTools.php:130
msgid "Assign language to content, repair missing language codes, sync taxonomies"
msgstr "Призначити мову контенту, виправити відсутні мовні коди, синхронізувати таксономії"

#: src/Tools/FixToolsTools.php:135
msgid "Synchronize posts taxonomies"
msgstr "Синхронізувати таксономії записів"

#: src/Tools/FixToolsTools.php:140
msgid "Check URL resolution cache status"
msgstr "Перевірити статус кешу розв'язання URL"

#: src/Tools/FixToolsTools.php:141
msgid "Clear and rebuild the URL resolution cache"
msgstr "Очистити та перебудувати кеш розв'язання URL"

#: src/Tools/FixToolsTools.php:142
msgid "Fix front-end links pointing at the wrong language"
msgstr "Виправити посилання фронтенду, що вказують на неправильну мову"

#: src/Tools/FixToolsTools.php:161
msgid "Repair duplicate statuses, refresh pending jobs, clear cache, reset translation service"
msgstr "Виправити статуси дублікатів, оновити завдання в черзі, очистити кеш, скинути сервіс перекладу"

#: src/Tools/ResetTools.php:65
msgid "Rewire internal links on legacy pre-4.7 posts that still need adjustment"
msgstr "Переналаштувати внутрішні посилання у застарілих записах версій до 4.7, які все ще потребують коригування"

#: src/Tools/ResetTools.php:73
msgid "Adjust legacy pre-4.7 internal links"
msgstr "Скоригувати застарілі внутрішні посилання версій до 4.7"

#: src/Tools/ResetTools.php:80
msgid "Sync product variations, galleries, taxonomies and stock; register missing reviews; create missing attribute and product-type translations"
msgstr "Синхронізувати варіації товарів, галереї, таксономії та запаси; зареєструвати відсутні відгуки; створити відсутні переклади атрибутів та типів товарів"

#: src/Tools/ResetTools.php:89
msgid "Synchronize product variations"
msgstr "Синхронізувати варіації товарів"

#: src/Tools/ResetTools.php:90
msgid "Synchronize products image galleries"
msgstr "Синхронізувати галереї зображень товарів"

#: src/Tools/ResetTools.php:91
msgid "Synchronize category metadata"
msgstr "Синхронізувати метадані категорій"

#: src/Tools/ResetTools.php:92
msgid "Synchronize stock for products and variations"
msgstr "Синхронізувати запаси для товарів і варіацій"

#: src/Tools/ResetTools.php:93
msgid "Create missing product attribute translations"
msgstr "Створити відсутні переклади атрибутів товарів"

#: src/Tools/ResetTools.php:94
msgid "Allow translation of missing product reviews"
msgstr "Дозволити переклад відсутніх відгуків про товари"

#: src/Tools/ResetTools.php:102
msgid "Reset WPML entirely — last-resort recovery"
msgstr "Повністю скинути WPML — крайній захід для відновлення"

#: src/Tools/ResetTools.php:116
msgid "Fix WPML's variation-translation relationship tables; permanently delete unused custom fields from product translations"
msgstr "Виправити таблиці зв'язків варіацій і перекладів WPML; назавжди видалити невикористовувані спеціальні поля з перекладів товарів"

#: src/Tools/ResetTools.php:125
msgid "Fix variation-translation relationships"
msgstr "Виправити зв'язки варіацій і перекладів"

#: src/Tools/ResetTools.php:126
msgid "Remove unused custom fields from product translations"
msgstr "Видалити невикористовувані спеціальні поля з перекладів товарів"

#: src/Tools/TmateTools.php:94
msgid "Synchronize with the Advanced Translation Editor"
msgstr "Синхронізувати з Advanced Translation Editor"

#: src/Tools/TmateTools.php:95
msgid "Re-sync job IDs and translator/manager assignments with the ATE server"
msgstr "Повторно синхронізувати ID завдань та призначення перекладачів/менеджерів із сервером ATE"

#: src/Tools/TmateTools.php:105
msgid "Sync local job IDs with ATE"
msgstr "Синхронізувати локальні ID завдань з ATE"

#: src/Tools/TmateTools.php:106
msgid "Sync translators and managers with ATE"
msgstr "Синхронізувати перекладачів і менеджерів з ATE"
