msgstr "Đồng bộ hóa thư viện hình ảnh sản phẩm"

#: src/Tools/ResetTools.php:91
msgid "Synchronize category metadata"
msgstr "Đồng bộ hóa siêu dữ liệu danh mục"

#: src/Tools/ResetTools.php:92
