msgstr "Kết nối lại các liên kết nội bộ trên các bài viết cũ trước phiên bản 4.7 vẫn cần điều chỉnh"

#: src/Tools/ResetTools.php:73
msgid "Adjust legacy pre-4.7 internal links"
msgstr "Điều chỉnh các liên kết nội bộ cũ trước phiên bản 4.7"

#: src/Tools/ResetTools.php:80
msgid "Sync product variations, galleries, taxonomies and stock; register missing reviews; create missing attribute and product-type translations"
msgstr "Đồng bộ hóa các biến thể sản phẩm, thư viện ảnh, phân loại và kho hàng; đăng ký các đánh giá còn thiếu; tạo các bản dịch thuộc tính và loại sản phẩm còn thiếu"

#: src/Tools/ResetTools.php:89
msgid "Synchronize product variations"
msgstr "Đồng bộ hóa các biến thể sản phẩm"

#: src/Tools/ResetTools.php:90
