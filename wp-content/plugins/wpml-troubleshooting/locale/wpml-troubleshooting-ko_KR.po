msgstr "내용을 이해했으며 계속 진행하겠습니다"

#: src/Tool/ATESyncController.php:81
msgid "Synchronize job IDs"
msgstr "작업 ID 동기화"

#: src/Tool/ATESyncController.php:89
msgid "Synchronize translators and translation managers with ATE"
msgstr "번역가 및 번역 관리자를 ATE와 동기화"

#: src/Tool/ATESyncController.php:92
msgid "Re-pushes your current translator and translation-manager assignments to the ATE server. Use when translators are missing from the ATE-side assignment list, or are assigned to jobs they should not see."
msgstr "현재 번역가 및 번역 관리자 할당 정보를 ATE 서버로 다시 푸시합니다. ATE 측 할당 목록에서 번역가가 누락되었거나, 보지 않아야 할 작업에 할당된 경우에 사용하십시오."

#: src/Tool/ATESyncController.php:106
msgid "Synchronize translators and managers"
msgstr "번역가 및 관리자 동기화"

